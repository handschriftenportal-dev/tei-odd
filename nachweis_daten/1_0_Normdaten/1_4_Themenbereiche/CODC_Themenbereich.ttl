hspv:CODC-D318 a skos:Concept;
  skos:notation "CODC-D318";
  skos:prefLabel "Blindlinierung"@de, "blind text ruling"@en;
  skos:broader hspv:CODC-D149;
  skos:definition "Die Zeilen wurden mit einem blinden Griffel vorgezeichnet. Die Blindlinierung ist bereits in Pergamenthandschriften des 5. und 6. Jahrhunderts nachweisbar."@de;
  dct:bibliographicCitation "Mazal, Lehrbuch der Handschriftenkunde, S. 69.";
