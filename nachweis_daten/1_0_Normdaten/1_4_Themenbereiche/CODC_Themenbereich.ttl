hspv:CODC-B199 a skos:Concept;
  skos:notation "CODC-B199";
  skos:prefLabel "Quart (Größe)"@de, "quarto (size)"@en;
  skos:altLabel "4° (Größe)"@de;
  skos:definition "Mit Quart (Größe) werden Handschriften bezeichnet, die entweder über ihre Abmessungen (Richtwert: Höhe 19-31 cm) oder über formatbezogene Signaturenreihen als Quart-Handschriften definiert sind."@de;
  skos:example hspv:0b34f21c-348a-4c68-9236-8b08279f5614;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

