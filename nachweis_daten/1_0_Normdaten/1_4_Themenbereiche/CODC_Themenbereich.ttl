hspv:CODC-C935 a skos:Concept;
  skos:notation "CODC-C935";
  skos:prefLabel "Ungefaltete Einzelblätter"@de, "plano (folding format)"@en;
  skos:altLabel "1° (Faltformat)"@de;
  skos:definition "Verwendung ungefalteter Einzelblätter, um beispielsweise durch Zusammenheften ganzer Pergament- oder Papierbögen zu Doppelblättern Großformate zu erzielen."@de;
  skos:example hspv:b0789fde-75f1-464a-8cb8-3c409ea17877;
  skos:inScheme hspv:CODC-C;
