hspv:CODC-B460 a skos:Concept;
  skos:notation "CODC-B460";
  skos:prefLabel "Großfolio"@de, "larger than folio"@en;
  skos:altLabel "Größer als Folio"@de, "Imperial"@de;
  skos:definition "Mit Großfolio werden Handschriften bezeichnet, die entweder über ihre Abmessungen (Richtwert: Höhe größer als 50 cm) oder über formatbezogene Signaturenreihen als Großfolio-Handschriften definiert sind."@de;
  skos:example hspv:f5e74d58-1cce-4949-a69c-a7da18c82e99;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

hspv:f5e74d58-1cce-4949-a69c-a7da18c82e99 a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00074101_00709/pct:0.23397,0.43602,99.1109,99.06781/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00074101/manifest>;
  schema:caption "München, BSB, Cgm 1, Bl. 348v." .

hspv:CODC-B200 a skos:Concept;
  skos:notation "CODC-B200";
  skos:prefLabel "Kleiner als Oktav"@de, "smaller than octavo"@en;
  skos:definition "Mit „Kleiner als Oktav“ werden Handschriften bezeichnet, die entweder über ihre Abmessungen (Richtwert: Höhe kleiner als 15 cm) oder über formatbezogene Signaturenreihen als kleiner als Oktav-Handschriften definiert sind."@de;
  skos:example hspv:857e4b73-e5bd-4c51-92b0-7d5cc54b800f;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

hspv:857e4b73-e5bd-4c51-92b0-7d5cc54b800f a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00091102_00156/pct:0.38204,0.1218,99.42693,99.33009/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00091102/manifest>;
  schema:caption "München, BSB, Cgm 141, Bl. 61v" .

hspv:CODC-B865 a skos:Concept;
  skos:notation "CODC-B865";
  skos:prefLabel "Schmalformat"@de, "tall format"@en;
  skos:definition "Als Schmalformate werden Handschriften bezeichnet, deren Breite im Vergleich zur Höhe geringer ist als bei den üblichen Buchformaten (Richtwert: Breite kleiner als Höhe/1,8). Diese Formate können durch Zuschneiden, Faltung oder Verwendung von Resten entstanden sein und wurden im Mittelalter oft für Rechnungsbücher oder Verzeichnisse verwendet."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 107.";
  skos:example hspv:6d26fb29-c674-4efc-baec-b3fab6ad15dd;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

hspv:6d26fb29-c674-4efc-baec-b3fab6ad15dd a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00059590_00020/pct:0.47443,0.12458,99.52557,99.77159/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00059590/manifest>;
  schema:caption "München, BSB, Cgm 3842, Bl. 9v" .

hspv:CODC-B742 a skos:Concept;
  skos:notation "CODC-B742";
  skos:prefLabel "Quadratformat"@de, "square format"@en;
  skos:definition "Als Quadratformate werden Handschriften bezeichnet, bei denen Höhe und Breite übereinstimmen (Richtwert: +/- 1 cm). Diese können durch Zuschneiden oder Verwendung von Resten entstanden sein."@de;
  skos:example hspv:fa55f2b4-4d2d-4e87-921f-9318a802a44c;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

hspv:fa55f2b4-4d2d-4e87-921f-9318a802a44c a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00001840_00023/pct:2.51698,0.94586,92.92849,94.64681/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00001840/manifest>;
  schema:caption "München, BSB, Cgm 1507, Bl. 10r." .

hspv:CODC-B978 a skos:Concept;
  skos:notation "CODC-B978";
  skos:prefLabel "Querformat"@de, "oblong format"@en;
  skos:definition "Als Querformate werden Handschriften bezeichnet, deren Breite die Höhe überragt (Richtwert: Breite mehr als 1 cm größer als Höhe). Querformate sind im Mittelalter vor allem bei Urkunden und Einblatthandschriften verbreitet, als Buchhandschriften treten sie vermehrt in der Frühen Neuzeit auf."@de;
  skos:example hspv:78c5ba01-82cf-408a-8e2a-60b393d634a1;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

hspv:78c5ba01-82cf-408a-8e2a-60b393d634a1 a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00038795_00022/pct:0.09179,1.20409,99.30014,98.20891/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00038795/manifest>;
  schema:caption "München, BSB, Cgm 1930, Bl. 10v." .

hspv:CODC-B234 a skos:Concept;
  skos:notation "CODC-B234";
  skos:prefLabel "Sonstiges Format (Größe/Seitenverhältnis)"@de, "other format (size)"@en;
  skos:definition "Sonstige Formate, die außerhalb der gängigen Buchformate liegen, z.B. Codices rotundi."@de;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .
