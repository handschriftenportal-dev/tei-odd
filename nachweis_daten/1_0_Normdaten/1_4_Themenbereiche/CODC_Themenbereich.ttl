hspv:CODC-C335 a skos:Concept;
  skos:notation "CODC-C335";
  skos:prefLabel "Schmalfoliofaltung"@de, "tall folio (folding format)"@en;
  skos:definition "Als Schmalfolio werden Formate bezeichnet, bei denen durch einmalige Längsfaltung eines Pergament- oder Papierbogens ein Doppelblatt entsteht."@de;
  skos:inScheme hspv:CODC-C;
  skos:topConceptOf hspv:CODC-C .

hspv:CODC-C495 a skos:Concept;
  skos:notation "CODC-C495";
  skos:prefLabel "Schmalquartfaltung"@de, "tall quarto (folding format)"@en;
  skos:definition "Als Schmalquart werden Formate bezeichnet, bei denen durch einmalige Quer- und einmalige Längsfaltung eines Pergament- oder Papierbogens zwei Doppelblätter entstehen."@de;
  skos:inScheme hspv:CODC-C;
  skos:topConceptOf hspv:CODC-C .

hspv:CODC-C394 a skos:Concept;
  skos:notation "CODC-C394";
  skos:prefLabel "Schmaloktavfaltung"@de, "tall octavo (folding format)"@en;
  skos:definition "Als Schmaloktav werden Formate bezeichnet, bei denen durch zweimalige Quer- und einmalige Längsfaltung eines Pergament- oder Papierbogens vier Doppelblätter entstehen."@de;
  skos:inScheme hspv:CODC-C;
  skos:topConceptOf hspv:CODC-C .

hspv:CODC-C189 a skos:Concept;
  skos:notation "CODC-C189";
  skos:prefLabel "Sonstiges Faltformat"@de, "other folding format"@en;
  skos:inScheme hspv:CODC-C;
  skos:topConceptOf hspv:CODC-C .

hspv:CODC-B a skos:ConceptScheme;
  skos:prefLabel "Format (Größe/Seitenverhältnis)"@de, "Format (size)"@en;
  skos:definition "Thesaurus: Format (Größe/Seitenverhältnis) (CODC-B)"@de, "Thesaurus: Format (size) (CODC-B)"@en;
  skos:inScheme hspv:CODC;
  skos:hasTopConcept hspv:CODC-B727, hspv:CODC-B199, hspv:CODC-B653, hspv:CODC-B460,
    hspv:CODC-B200, hspv:CODC-B865, hspv:CODC-B742, hspv:CODC-B978, hspv:CODC-B234 .

hspv:CODC-B727 a skos:Concept;
  skos:notation "CODC-B727";
  skos:prefLabel "Folio (Größe)"@de, "folio (size)"@en;
  skos:altLabel "2° (Größe)"@de;
  skos:definition "Mit Folio (Größe) werden Handschriften bezeichnet, die entweder über ihre Abmessungen (Richtwert: Höhe 28-51 cm) oder formatbezogene Signaturenreihen als Folio-Handschriften definiert sind."@de;
  skos:example hspv:cd38a70c-6d9b-4f3e-8172-a5d90d8c6e14;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

