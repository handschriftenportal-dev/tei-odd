hspv:CODC-C636 a skos:Concept;
  skos:notation "CODC-C636";
  skos:prefLabel "Foliofaltung"@de, "folio (folding format)"@en;
  skos:altLabel "2° (Faltformat)"@de;
  skos:definition "Mit Foliofaltung werden Formate bezeichnet, bei denen durch einmaliges Falten eines Pergament- oder Papierbogens ein Doppelblatt entsteht."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 106.";
