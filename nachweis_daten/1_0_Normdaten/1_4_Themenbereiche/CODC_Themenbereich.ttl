hspv:CODC-D400 a skos:Concept;
  skos:notation "CODC-D400";
  skos:prefLabel "Spaltenzählung"@de, "column signatures"@en;
  skos:altLabel "Kolumnenzählung"@de;
  skos:definition "Alte Spaltenzählung bzw. Kolumnenzählung mit Buchstaben oder Ziffern ist relativ selten."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 162.";
  skos:example hspv:a58ecbb6-9e5a-412e-9353-25425de90051;
  skos:inScheme hspv:CODC-D;
  skos:topConceptOf hspv:CODC-D .

hspv:a58ecbb6-9e5a-412e-9353-25425de90051 a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00105661_00015/pct:0.82645,0.15604,99.0136,14.76497/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00105661/manifest>;
  schema:caption "München, BSB, Clm 28158, Bl. 6r." .

hspv:CODC-D541 a skos:Concept;
  skos:notation "CODC-D541";
  skos:prefLabel "Seitentitel"@de, "running title"@en;
  skos:altLabel "Seitenüberschriften"@de;
  skos:definition "Als Seitentitel oder Seitenüberschriften werden Buch- und Kapitelangaben am oberen Rand des jeweiligen Blattes bezeichnet. Dieses frühmittelalterliche Verfahren wurde im 12. Jahrhundert wieder aufgenommen."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 165.";
  skos:example hspv:b1a8615f-62b3-4207-aaa1-b9757792f343;
  skos:inScheme hspv:CODC-D;
  skos:topConceptOf hspv:CODC-D .

hspv:b1a8615f-62b3-4207-aaa1-b9757792f343 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0044/0000004482/00000006.jpx/pct:6.8109,6.10755,65.17094,20.19231/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000004482/manifest.json>;
  schema:caption "Leipzig, Universitätsbibliothek, Ms 1329, Bl. 2v." .

hspv:CODC-D742 a skos:Concept;
  skos:notation "CODC-D742";
  skos:prefLabel "Kolumnentitel"@de, "column title"@en;
  skos:altLabel "Spaltentitel"@de;
  skos:definition "Als Kolumnentitel werden Überschriften über den einzelnen Spalten einer Handschrift bezeichnet. Sie dienen der Orientierung und leichteren Zitierbarkeit."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 165.";
  skos:example hspv:8b02a2ea-0077-4fa9-85d6-adf12eb06952;
  skos:inScheme hspv:CODC-D;
  skos:topConceptOf hspv:CODC-D .

hspv:8b02a2ea-0077-4fa9-85d6-adf12eb06952 a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00106065_00025/pct:0.69758,0.45165,98.68691,17.64081/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00106065/manifest>;
  schema:caption "Ansbach, Staatliche Bibliothek, Ms. Lat. 91, Bl. 12r." .

hspv:CODC-D177 a skos:Concept;
  skos:notation "CODC-D177";
  skos:prefLabel "Kustoden"@de, "quire counting and/or catchwords"@en;
  skos:definition "Nach dem Schreiben wurden die Lagen gekennzeichnet, damit sie beim Binden in der richtigen Reihenfolge angeordnet werden konnten. Es gibt verschiedene Arten der Kennzeichnung."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 123.";
  skos:example hspv:d49a7aa4-693a-46c2-8fda-228f14c7429e;
  skos:narrower hspv:CODC-D571, hspv:CODC-D611, hspv:CODC-D608;
  skos:inScheme hspv:CODC-D;
  skos:topConceptOf hspv:CODC-D .

hspv:d49a7aa4-693a-46c2-8fda-228f14c7429e a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0047/0000004783/00000018.jpx/pct:22.75641,72.32906,71.26068,14.58333/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000004783/manifest.json>;
  schema:caption "Leipzig, Universitätsbibliothek, Ms 1330, Bl. 7v." .

hspv:CODC-D571 a skos:Concept;
  skos:notation "CODC-D571";
  skos:prefLabel "Lagenzählung"@de, "quire counting"@en;
  skos:broader hspv:CODC-D177;
  skos:definition "Die älteste Form der Lagenbezeichnung ist die Lagenzählung. Sie wurde auf der ersten oder letzten Lagenseite, meist am unteren Rand, angebracht. Zum Zählen der Lagen wurden römische, später auch arabische Ziffern oder ausgeschriebene Zählungen verwendet. Seltener kommt auch eine Zählung mit Buchstaben vor."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 123f.";
  skos:example hspv:6eae481f-f2f7-4992-af9f-b9dbe02e1f29;
  skos:inScheme hspv:CODC-D .

hspv:6eae481f-f2f7-4992-af9f-b9dbe02e1f29 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0047/0000004783/00000018.jpx/pct:22.75641,72.32906,71.26068,14.58333/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000004783/manifest.json>;
  schema:caption "Leipzig, Universitätsbibliothek, Ms 1330, Bl. 7v." .

hspv:CODC-D611 a skos:Concept;
  skos:notation "CODC-D611";
  skos:prefLabel "Lagenblattzählung"@de, "quire leaves counting"@en;
  skos:broader hspv:CODC-D177;
  skos:definition "Unter Lagenblattzählung wird eine Lagenbezeichnung verstanden, bei der nicht oder nicht nur die Lagen selbst, sondern auch deren einzelne Blätter gezählt werden. Meist werden nur die Blätter der ersten Lagenhälfte durchgezählt."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 125.";
  skos:example hspv:6986624d-af07-448b-a59c-c9ffcc8f2f46;
  skos:narrower hspv:CODC-D387, hspv:CODC-D511;
  skos:inScheme hspv:CODC-D .

hspv:6986624d-af07-448b-a59c-c9ffcc8f2f46 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0548/0000054811/00000033.jpx/pct:74.67949,85.11396,12.01923,6.33903/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000054811/manifest.json>;
  schema:caption "Leipzig, Bundesverwaltungsgericht, Bibliothek, MS 2° E 2785, Bl. 12r." .

hspv:CODC-D387 a skos:Concept;
  skos:notation "CODC-D387";
  skos:prefLabel "Lagensignaturen"@de, "quire signatures"@en;
  skos:broader hspv:CODC-D611;
  skos:definition "Mit Lagensignatur wird eine Form der Lagenblattzählung bezeichnet, bei der sowohl die Lage als auch die Lagenblätter gezählt werden, meist mit Buchstaben für die Lage und Ziffern für die Lagenblätter. Diese Form der Lagenbezeichnung ist auch im Bereich der frühen Drucke sehr verbreitet."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 125.";
  skos:example hspv:b8489af1-223b-40c7-a949-dccb8a834118;
  skos:inScheme hspv:CODC-D .

hspv:b8489af1-223b-40c7-a949-dccb8a834118 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0548/0000054811/00000033.jpx/pct:74.67949,85.11396,12.01923,6.33903/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000054811/manifest.json>;
  schema:caption "Leipzig, Bundesverwaltungsgericht, Bibliothek, MS 2° E 2785, Bl. 12r." .

hspv:CODC-D511 a skos:Concept;
  skos:notation "CODC-D511";
  skos:prefLabel "Lagenfoliierung"@de, "quire foliation"@en;
  skos:broader hspv:CODC-D611;
  skos:definition "Mit Lagenfoliierung wird eine Form der Lagenblattzählung bezeichnet, bei der nur die Lagenblätter, nicht aber die Lagen selbst gezählt werden. Für die Zählung wurden entweder Buchstaben oder Ziffern verwendet."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 125.";
  skos:example hspv:7145bdc0-bb1d-4d47-a635-06536edb6a1a;
  skos:inScheme hspv:CODC-D .

hspv:7145bdc0-bb1d-4d47-a635-06536edb6a1a a schema:ImageObject;
  schema:contentUrl <https://images.iiif.slub-dresden.de/iiif/2/data%2Fkitodo%2FAntiCipaa_1801123012%2FAntiCipaa_1801123012_tif%2Fjpegs%2F00000020.tif.medium.jpg/pct:32.7,74.5377,47.9,16.99858/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.slub-dresden.de/iiif/2/1801123012/manifest.json>;
  schema:caption "Dresden, SLUB, St. Marienthal F 1/4, Bl. 7v." .

hspv:CODC-D608 a skos:Concept;
  skos:notation "CODC-D608";
  skos:prefLabel "Reklamanten"@de, "catchwords"@en;
  skos:broader hspv:CODC-D177;
  skos:definition "Als Reklamanten bzw. Wortreklamanten bezeichnet man die in der Regel auf der Versoseite des letzten Blattes einer Lage vermerkten Anfangsworte der nächsten Lage. Dies sollte die richtige Reihenfolge der Lagen beim Binden unterstützen. Reklamanten treten erstmals im 11. Jahrhundert auf und werden ab dem 12. Jahrhundert zunehmend häufiger."@de;
  dct:bibliographicCitation "Mazal, Lehrbuch der Handschriftenkunde, S. 70.";
  skos:example hspv:86c20042-5090-49ae-b0df-64ee8b9a691c;
  skos:inScheme hspv:CODC-D .

hspv:86c20042-5090-49ae-b0df-64ee8b9a691c a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0358/0000035872/00000022.jpx/pct:18.98438,71.12847,75.02604,21.96181/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000035872/manifest.json>;
  schema:caption "Leipzig, Universitätsbibliothek, Ms 669, Bl. 10v." .

hspv:CODC-D483 a skos:Concept;
  skos:notation "CODC-D483";
  skos:prefLabel "Glossen"@de, "gloss"@en;
  skos:altLabel "Kommentare"@de;
  skos:definition "Die Handschrift enthält neben dem Haupttext einen Kommentar bzw. eine Glosse zum Text. Die Glosse kann verschiedene Formen haben. In manchen Fällen wird der Schriftraum bereits für eine Aufteilung in Haupttext und Glosse eingerichtet, z.B. durch eigene Spalten für Text und Glosse. Die Glossen können aber auch in den Haupttext integriert (Interlinearglossen) oder außerhalb des Schriftraums eingetragen sein (Marginalglossen). Zudem können Text und Glosse durch verschiedene Schriften, Schriftgrade oder Farben voneinander abgesetzt sein."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 139.";
  skos:example hspv:e05ded6e-ace4-41ef-8255-7f614de117c5;
  skos:narrower hspv:CODC-D765, hspv:CODC-D782, hspv:CODC-D791;
  skos:inScheme hspv:CODC-D;
  skos:topConceptOf hspv:CODC-D .

hspv:e05ded6e-ace4-41ef-8255-7f614de117c5 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0095/0000009594/00000325.jpx/pct:42.68162,44.3198,31.49038,9.33048/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000009594/manifest.json>;
  schema:caption "Leipzig, Universitätsbibliothek, Ms 1118, Bl. 160r." .

hspv:CODC-D765 a skos:Concept;
  skos:notation "CODC-D765";
  skos:prefLabel "Interlinearglossen"@de, "interlinear gloss"@en;
  skos:broader hspv:CODC-D483;
  skos:definition "Als Interlinearglossen werden Glossen bzw. Kommentare bezeichnet, die zwischen die Zeilen des Haupttextes eingetragen wurden. Oft wurde diese Form der Glossierung für Übersetzungen ganzer Texte oder einzelner Wörter verwendet, sog. Interlinearversionen."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 138.";
  skos:example hspv:53bab4ab-4f99-45d7-aa55-161261b65cae;
  skos:inScheme hspv:CODC-D .

hspv:53bab4ab-4f99-45d7-aa55-161261b65cae a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0095/0000009594/00000325.jpx/pct:42.68162,44.3198,31.49038,9.33048/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000009594/manifest.json>;
  schema:caption "Leipzig, Universitätsbibliothek, Ms 1118, Bl. 160r." .

hspv:CODC-D782 a skos:Concept;
  skos:notation "CODC-D782";
  skos:prefLabel "Marginalglossen"@de, "marginal gloss"@en;
  skos:broader hspv:CODC-D483;
  skos:definition "Als Marginalglossen werden Glossen bzw. Kommentare bezeichnet, die sich außerhalb des Schriftraums auf den Rändern der Seite befinden."@de;
  skos:example hspv:c572b473-a8f5-493b-9cc4-2d890a087189;
  skos:inScheme hspv:CODC-D .

hspv:c572b473-a8f5-493b-9cc4-2d890a087189 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0552/0000055286/00000035.jpx/pct:4.43376,28.09829,86.75214,59.24145/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000055286/manifest.json>;
  schema:caption "Leipzig, Bundesverwaltungsgericht, MS 4° E 5164, Bl. 13r." .

hspv:CODC-D791 a skos:Concept;
  skos:notation "CODC-D791";
  skos:prefLabel "sonstige Glossierungsformen"@de, "other kinds of gloss"@en;
  skos:altLabel "sonstige Kommentarformen"@de;
  skos:broader hspv:CODC-D483;
