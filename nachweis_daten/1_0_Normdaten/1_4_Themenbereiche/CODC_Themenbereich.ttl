  schema:caption "München, BSB, Clm 6229, Bl. 133v." .

hspv:CODC-B653 a skos:Concept;
  skos:notation "CODC-B653";
  skos:prefLabel "Oktav (Größe)"@de, "octavo (size)"@en;
  skos:altLabel "8° (Größe)"@de;
  skos:definition "Mit Oktav (Größe) werden Handschriften bezeichnet, die entweder über ihre Abmessungen (Richtwert: Höhe 13-21 cm) oder über formatbezogene Signaturenreihen als Oktav-Handschriften definiert sind."@de;
  skos:example hspv:4b20f9d6-c135-497b-bfb1-7c4e813e190c;
  skos:inScheme hspv:CODC-B;
  skos:topConceptOf hspv:CODC-B .

