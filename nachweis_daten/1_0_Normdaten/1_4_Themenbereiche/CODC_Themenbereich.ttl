hspv:CODC-C465 a skos:Concept;
  skos:notation "CODC-C465";
  skos:prefLabel "Duodezfaltung"@de, "duodecimo (folding format)"@en;
  skos:altLabel "12° (Faltformat)"@de;
  skos:definition "Als Duodez werden Formate bezeichnet, bei denen jedes Blatt ein Zwölftel eines Bogens ist. Dies kann z.B. durch viermaliges Falten erreicht werden."@de;
