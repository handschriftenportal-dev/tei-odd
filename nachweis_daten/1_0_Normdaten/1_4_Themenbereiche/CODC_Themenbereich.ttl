hspv:CODC-C978 a skos:Concept;
  skos:notation "CODC-C978";
  skos:prefLabel "Kleinere Faltungen als Sedez"@de, "smaller foldings than sexto-decimo"@en;
  skos:definition "Kleinere Formate, die durch mehr als vier Faltungen entstehen."@de;
  skos:inScheme hspv:CODC-C;
