  schema:caption "München, BSB, Cod.graec. 263, Bl. 376r." .

hspv:CODC-A783 a skos:Concept;
  skos:notation "CODC-A783";
  skos:prefLabel "industriell gefertigtes Papier (Beschreibstoff)"@de, "paper of industrial manufacture (support)"@en;
  skos:broader hspv:CODC-A366;
  skos:definition "Ab dem 19. Jahrhundert kam neben dem handwerklich hergestellten auch Papier aus industrieller Fertigung auf."@de;
  skos:example hspv:e994f1e2-32f9-4951-b014-943018478d03;
