hspv:CODC-A a skos:ConceptScheme;
  skos:prefLabel "Beschreibstoff"@de, "Support material"@en;
  skos:definition "Thesaurus: Beschreibstoff (CODC-A)"@de, "Thesaurus: Support material (CODC-A)"@en;
  skos:inScheme hspv:CODC;
  skos:hasTopConcept hspv:CODC-A194, hspv:CODC-A800, hspv:CODC-A366, hspv:CODC-A645,
    hspv:CODC-A601, hspv:CODC-A325, hspv:CODC-A635, hspv:CODC-A480 .

hspv:CODC-A194 a skos:Concept;
  skos:notation "CODC-A194";
  skos:prefLabel "Papyrus (Beschreibstoff)"@de, "papyrus (support)"@en;
  skos:definition "Papyrus war in der griechisch-römischen Antike der vorherrschende Beschreibstoff, bis im 4. Jahrhundert Pergament als konkurrierender Beschreibstoff an Bedeutung gewann."@de;
  dct:bibliographicCitation "Mazal, Lehrbuch der Handschriftenkunde, S. 42-44.";
  skos:example hspv:43ef6fdb-0257-4625-9c90-6ccd0ba0eb01;
  skos:inScheme hspv:CODC-A;
  skos:topConceptOf hspv:CODC-A .

hspv:43ef6fdb-0257-4625-9c90-6ccd0ba0eb01 a schema:ImageObject;
  schema:contentUrl <https://images.iiif.slub-dresden.de/iiif/2/data%2Fkitodo%2Fgrieha-m_351370048%2Fgrieha-m_351370048_tif%2Fjpegs%2F00000001.tif.medium.jpg/pct:9.1,5.31335,79.9,86.78474/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.slub-dresden.de/iiif/2/351370048/manifest.json>;
  schema:caption "Dresden, SLUB, Mscr.Dresd.R.306, S. 1" .

hspv:CODC-A800 a skos:Concept;
  skos:notation "CODC-A800";
  skos:prefLabel "Pergament (Beschreibstoff)"@de, "parchment (support)"@en;
  skos:definition "Pergament war seit dem 2. vorchristlichen Jahrhundert bekannt und wurde seit dem frühen Mittelalter und bis zum Ende des 13. Jahrhunderts zum vorherrschenden Beschreibstoff. Ab dem 14. Jahrhundert wurde Pergament nach und nach durch Papier als Beschreibstoff verdrängt."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 105.";
  skos:example hspv:c1309cb0-b1fe-4bca-9cd5-542083bf7c66;
  skos:narrower hspv:CODC-A915, hspv:CODC-A959, hspv:CODC-A794, hspv:CODC-A653, hspv:CODC-A117,
    hspv:CODC-A839;
  skos:inScheme hspv:CODC-A;
  skos:topConceptOf hspv:CODC-A .

hspv:c1309cb0-b1fe-4bca-9cd5-542083bf7c66 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0047/0000004777/00000167.jpx/pct:17.1875,61.28472,73.30729,33.26389/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000004777/manifest.json>;
  schema:caption "Leipzig, UB, Ms 431, Bl. 82r" .

hspv:CODC-A915 a skos:Concept;
  skos:notation "CODC-A915";
  skos:prefLabel "Kalbspergament (Beschreibstoff)"@de, "calfskin parchment (support)"@en;
  skos:broader hspv:CODC-A800;
  skos:definition "Kalbspergament weist im Gegensatz zu Schafs- und Ziegenpergament meist eine weniger deutlich sichtbare Porenstruktur auf. Auch die Unterscheidung von Haar- und Fleischseite ist oft schwierig. Aus einer Kalbshaut kann ein Pergamentbogen von ca. 100 x 80 cm gewonnen werden. Tendenziell wurde im Süden Europas eher Schafs- und Ziegenpergament, im Norden eher Kalbspergament verwendet."@de;
  dct:bibliographicCitation "Mazal, Geschichte der Buchkultur, Bd. 4/1, S. 22-25.";
  skos:example hspv:74b80468-5c66-4da7-b0b3-679b2f142ab5;
  skos:inScheme hspv:CODC-A .

hspv:74b80468-5c66-4da7-b0b3-679b2f142ab5 a schema:ImageObject;
  schema:contentUrl <https://www.franconica.online/o/iiif/2/33018/pct:62.45614,62.44213,36.92982,34.9537/pct:100/0/default.jpg>;
  schema:identifier <https://www.franconica.online/o/iiif/2/32950/manifest>;
  schema:caption "Würzburg, UB, M.p.th.f.24, Bl. 17v/18r" .

hspv:CODC-A959 a skos:Concept;
  skos:notation "CODC-A959";
  skos:prefLabel "Schafspergament (Beschreibstoff)"@de, "sheepskin parchment (support)"@en;
  skos:broader hspv:CODC-A800;
  skos:definition "Schafspergament weist im Gegensatz zu Kalbspergament meist eine deutlich sichtbare Porenstruktur auf und ist im Gegensatz zu Ziegenpergament eher gelblich gefärbt. Aus einer Schafshaut kann ein Pergamentbogen von ca. 60-80 x 40-60 cm gewonnen werden. Tendenziell wurde im Süden Europas eher Schafs- und Ziegenpergament, im Norden eher Kalbspergament verwendet."@de;
  dct:bibliographicCitation "Mazal, Geschichte der Buchkultur, Bd. 4/1, S. 22-25.";
  skos:example hspv:d4f0ba28-f374-40f6-aed8-f00b21f2640d;
  skos:inScheme hspv:CODC-A .

hspv:d4f0ba28-f374-40f6-aed8-f00b21f2640d a schema:ImageObject;
  schema:contentUrl <https://www.franconica.online/o/iiif/2/32958/pct:66.75439,67.65046,33.07018,26.79398/pct:100/0/default.jpg>;
  schema:identifier <https://www.franconica.online/o/iiif/2/32950/manifest>;
  schema:caption "Würzburg, UB, M.p.th.f.24, Bl. 2v/3r" .

hspv:CODC-A794 a skos:Concept;
  skos:notation "CODC-A794";
  skos:prefLabel "Ziegenpergament (Beschreibstoff)"@de, "goatskin parchment (support)"@en;
  skos:broader hspv:CODC-A800;
  skos:definition "Ziegenpergament weist im Gegensatz zu Kalbspergament meist eine deutlich sichtbare Porenstruktur auf und ist im Gegensatz zu Schafspergament eher grau-bräunlich gefärbt. Tendenziell wurde im Süden Europas eher Schafs- und Ziegenpergament, im Norden eher Kalbspergament verwendet."@de;
  dct:bibliographicCitation "Mazal, Geschichte der Buchkultur, Bd. 4/1, S. 22-25.";
  skos:example hspv:05a25519-f81c-415d-90d1-37387f1f87ba;
  skos:inScheme hspv:CODC-A .

hspv:05a25519-f81c-415d-90d1-37387f1f87ba a schema:ImageObject;
  schema:contentUrl <https://digital.ub.uni-duesseldorf.de/i3f/v20/3774458/pct:45.61256,19.67213,36.78161,22.29508/pct:100/0/default.jpg>;
  schema:identifier <https://digital.ub.uni-duesseldorf.de/i3f/v20/3774436/manifest>;
  schema:caption "Universitäts- und Landesbibliothek Düsseldorf, Ms. B 2a, hinteres Vorsatz" .

hspv:CODC-A653 a skos:Concept;
  skos:notation "CODC-A653";
  skos:prefLabel "Pergament von anderen Tieren (Beschreibstoff)"@de, "other kinds of parchment (support)"@en;
  skos:broader hspv:CODC-A800;
  skos:definition "Pergament, das von anderen Tieren als Kalb, Schaf oder Ziege stammt."@de;
  skos:inScheme hspv:CODC-A .

hspv:CODC-A117 a skos:Concept;
  skos:notation "CODC-A117";
  skos:prefLabel "Pergament mit deutlichen Unterschieden zwischen Haar- und Fleischseiten (Beschreibstoff)"@de,
    "parchment with salient differences between flesh and hair side (support)"@en;
  skos:broader hspv:CODC-A800;
  skos:definition "Pergament, das im frühen Mittelalter in Italien, Spanien und Südfrankreich hergestellt wurde, war auf der Fleischseite sorgfältiger bearbeitet als auf der ungleichmäßigeren und meist dunkleren Haarseite."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 107.";
  skos:example hspv:318cabd2-ffd6-4f88-81cd-787e7b8980e4;
  skos:inScheme hspv:CODC-A .

hspv:318cabd2-ffd6-4f88-81cd-787e7b8980e4 a schema:ImageObject;
  schema:contentUrl <https://www.franconica.online/o/iiif/2/32958/pct:66.75439,67.65046,33.07018,26.79398/pct:100/0/default.jpg>;
  schema:identifier <https://www.franconica.online/o/iiif/2/32950/manifest>;
  schema:caption "Würzburg, UB, M.p.th.f.24, Bl. 2v/3r" .

hspv:CODC-A839 a skos:Concept;
  skos:notation "CODC-A839";
  skos:prefLabel "Pergament ohne deutliche Unterschiede zwischen Haar- und Fleischseiten (Beschreibstoff)"@de,
    "parchment without differences between flesh and hair side (support)"@en;
  skos:broader hspv:CODC-A800;
  skos:definition "Im frühen Mittelalter wurde Pergament ohne Unterschiede zwischen Haar- und Fleischseiten meist in nördlichen Regionen hergestellt. Seit dem 13. Jahrhundert wurde allgemein ein feineres Pergament bevorzugt."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 107.";
  skos:example hspv:af5bc093-5d73-4ace-8baa-99c5ef4be366;
  skos:inScheme hspv:CODC-A .

hspv:af5bc093-5d73-4ace-8baa-99c5ef4be366 a schema:ImageObject;
  schema:contentUrl <https://www.franconica.online/o/iiif/2/33018/pct:62.45614,62.44213,36.92982,34.9537/pct:100/0/default.jpg>;
  schema:identifier <https://www.franconica.online/o/iiif/2/32950/manifest>;
  schema:caption "Würzburg, UB, M.p.th.f.24, Bl. 17v/18r" .

hspv:CODC-A366 a skos:Concept;
  skos:notation "CODC-A366";
  skos:prefLabel "Papier (Beschreibstoff)"@de, "paper (support)"@en;
  skos:definition "Papier wurde seit dem 13. Jahrhundert in Italien, Frankreich und Spanien hergestellt und verbreitete sich ab dem 14. Jahrhundert zunehmend. Im 15. Jahrhundert war Papier der vorherrschende Beschreibstoff."@de;
  dct:bibliographicCitation "Schneider, Paläographie und Handschriftenkunde, S. 110.";
  skos:example hspv:8d7b0ecf-1c94-4c98-b8fd-b0721ede5c8b;
  skos:narrower hspv:CODC-A491, hspv:CODC-A725, hspv:CODC-A783;
  skos:inScheme hspv:CODC-A;
  skos:topConceptOf hspv:CODC-A .

hspv:8d7b0ecf-1c94-4c98-b8fd-b0721ede5c8b a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0115/0000011533/00000025.jpx/pct:4.03312,7.88818,86.85897,27.59972/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000011533/manifest.json>;
  schema:caption "Leipzig, UB, Ms 1226, Bl. 4r." .

hspv:CODC-A491 a skos:Concept;
  skos:notation "CODC-A491";
  skos:prefLabel "Papier aus Fertigung des lateinisch-europäischen Kulturraums (Beschreibstoff)"@de,
    "paper of European manufacture (support)"@en;
  skos:broader hspv:CODC-A366;
  skos:definition "Papier wurde seit dem 13. Jahrhundert in Italien, Frankreich und Spanien hergestellt und verbreitete sich ab dem 14. Jahrhundert zunehmend. Im 15. Jahrhundert war Papier der vorherrschende Beschreibstoff in Europa."@de;
  skos:example hspv:737c81fa-3fed-4a22-aa8d-e6da1148207a;
  skos:inScheme hspv:CODC-A .

hspv:737c81fa-3fed-4a22-aa8d-e6da1148207a a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0115/0000011533/00000025.jpx/pct:4.03312,7.88818,86.85897,27.59972/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000011533/manifest.json>;
  schema:caption "Leipzig, UB, Ms 1226, Bl. 4r." .

hspv:CODC-A725 a skos:Concept;
  skos:notation "CODC-A725";
  skos:prefLabel "Papier aus Fertigung des arabischen Kulturraums (Beschreibstoff)"@de,
    "paper of Arabic manufacture (support)"@en;
  skos:broader hspv:CODC-A366;
  skos:definition "Bei Papier aus Fertigung des arabischen Kulturraums wird unterschieden zwischen westlichem („arabe occidental“) und östlichem („arabe oriental“) Typ."@de;
  skos:example hspv:54d0f84d-7ad4-4302-9f42-97b8ed7b3ea7;
  skos:narrower hspv:CODC-A773, hspv:CODC-A797;
  skos:inScheme hspv:CODC-A .

hspv:54d0f84d-7ad4-4302-9f42-97b8ed7b3ea7 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0131/0000013154/00000015.jpx/pct:35.63034,10.77279,50.02671,27.74217/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000013154/manifest.json>;
  schema:caption "Leipzig, UB, Cod. gr. 17, Bl. 5r." .

hspv:CODC-A773 a skos:Concept;
  skos:notation "CODC-A773";
  skos:prefLabel "Papier „arabe occidental“ (Beschreibstoff)"@de, "paper „arabe occidental“ (support)"@en;
  skos:broader hspv:CODC-A725;
  skos:definition "Das Papier „arabe occidental“ wurde in den Westgebieten des osmanischen Reichs, im Maghreb und in Spanien hergestellt und ähnelt dem italienischen Papier. Manchmal weist es ein Zickzack-Zeichen auf."@de;
  dct:bibliographicCitation "M. Agati, The Manuscript Book, S. 95.";
  skos:example hspv:ab586b3e-efd4-4d17-814a-0e95bd0a47cc;
  skos:inScheme hspv:CODC-A .

hspv:ab586b3e-efd4-4d17-814a-0e95bd0a47cc a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00072398_00101/pct:1.59384,0.85047,96.86727,98.55617/pct:100/0/default.jpg>;
  schema:identifier <https://api.digitale-sammlungen.de/iiif/presentation/v2/bsb00072398/manifest>;
  schema:caption "München, BSB, Cod.graec. 184, Bl. 49r." .

hspv:CODC-A797 a skos:Concept;
  skos:notation "CODC-A797";
  skos:prefLabel "Papier „arabe oriental“ (Beschreibstoff)"@de, "paper „arabe oriental“ (support)"@en;
  skos:broader hspv:CODC-A725;
  skos:definition "Das Papier „arabe oriental“ wurde in den Ostgebieten des osmanischen Reichs, in Irak, Ägypten, Syrien und Palästina, hergestellt. Es hat eine regelmäßige Struktur und ist glatt, die Kettlinien sind meist nur schwer erkennbar. Es weist nie ein Zickzack-Zeichen auf."@de;
  dct:bibliographicCitation "M. Agati, The Manuscript Book, S. 95.";
  skos:example hspv:c597c931-6a95-4f30-8eb4-b17a1deabec0;
  skos:inScheme hspv:CODC-A .

