hspv:FORM-E389 a skos:Concept;
  skos:notation "FORM-E389";
  skos:prefLabel "nur indirekt erhalten"@de, "indirectly preserved"@en;
  skos:definition "Das Material ist nur indirekt, z.B. durch Reproduktionen oder Spuren auf anderen Materialien, erhalten, die physische Handschrift selbst ist jedoch nicht erhalten"@de;
  skos:narrower hspv:FORM-E505, hspv:FORM-E248;
  skos:inScheme hspv:FORM-E;
  skos:topConceptOf hspv:FORM-E .

hspv:FORM-E505 a skos:Concept;
  skos:notation "FORM-E505";
  skos:prefLabel "in Reproduktionen erhalten"@de, "preserved in reproductions"@en;
  skos:broader hspv:FORM-E389;
  skos:definition "Das Material ist nur in Reproduktionen (z.B. Photographien, Mikrofilmen u.ä.) erhalten"@de;
  skos:inScheme hspv:FORM-E .

hspv:FORM-E248 a skos:Concept;
  skos:notation "FORM-E248";
  skos:prefLabel "in Spuren erhalten"@de, "preserved in traces"@en;
  skos:broader hspv:FORM-E389;
  skos:definition "Das Material ist nur in physischen Spuren auf anderen Materialien erhalten"@de;
  skos:narrower hspv:FORM-E156;
  skos:inScheme hspv:FORM-E .

hspv:FORM-E156 a skos:Concept;
  skos:notation "FORM-E156";
  skos:prefLabel "Abklatsch"@de, "offset"@en;
  skos:broader hspv:FORM-E248;
  skos:definition "Die Schrift oder andere Bestandteile des Materials sind als Abklatsch auf einem Trägermaterial erhalten, der eigentliche Schriftträger ist jedoch nicht erhalten"@de;
  skos:example hspv:cb695cdb-0d5e-4873-8f4c-bf760a0d7b20;
  skos:inScheme hspv:FORM-E .

