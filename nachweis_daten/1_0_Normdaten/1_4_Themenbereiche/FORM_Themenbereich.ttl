hspv:FORM-F463 a skos:Concept;
  skos:notation "FORM-F463";
  skos:prefLabel "sekundäre Verwendung als Ansetzfalz"@de, "reuse as endleaf guard"@en;
  skos:altLabel "sekundäre Verwendung als Ansatzfalz"@de;
  skos:broader hspv:FORM-F556;
  skos:definition "Das fragmentierte Material wurde als Ansetzfalz wiederverwendet. Ansetzfälze sind Streifen mit einer durchschnittlichen Breite von 5 bis 10 Zentimeter, die eine Verbindung zwischen den Buchdeckeln und dem Buchblock in einem Holzdeckeleinband bilden, wobei eine Hälfte auf den Innendeckel aufgeklebt ist, während die andere Hälfte freisteht. Wie auch die Spiegel dienen Ansetzfälze der Fixierung der Bünde. Wegen der großen Kraft, die auf die Ansetzfälze wirkt, wurde ausschließlich auf ehemalige Pergamenthandschriften zurückgegriffen."@de;
  skos:example hspv:50714131-67a7-412c-adf4-ab5334e35b98;
  skos:inScheme hspv:FORM-F .

hspv:50714131-67a7-412c-adf4-ab5334e35b98 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0041/0000004121/00000002.jpx/pct:78.87286,5.28846,20.32585,91.34615/pct:100/0/default.jpg>;
  schema:identifier <https://iiif.ub.uni-leipzig.de/0000004121/manifest.json>;
  schema:caption "Leipzig, UB, Ms 1344, Vorderspiegel" .

hspv:FORM-F429 a skos:Concept;
  skos:notation "FORM-F429";
  skos:prefLabel "sekundäre Verwendung als Flügelfalz"@de, "reuse as text guard"@en;
  skos:broader hspv:FORM-F556;
  skos:definition "Das fragmentierte Material wurde als Flügelfalz wiederverwendet. Flügelfälze befinden sich vorn und hinten zwischen den Buchdeckeln und dem Buchblock, gehen jedoch keine Verbindung zum Buchdeckel ein, sondern sind um die erste und/oder letzte Lage herumgelegt und mitgeheftet. Ihre Funktion besteht somit vor allem in einer Fixierung der äußeren Lagen im Lagenverbund und in der Stabilisierung des Buchblocks. In einer besonderen Form können Flügelfälze auch über den Rücken des Buchblocks laufen."@de;
  skos:example hspv:83012b67-4446-48a7-bfb3-8d5a71d04cea;
  skos:inScheme hspv:FORM-F .

hspv:83012b67-4446-48a7-bfb3-8d5a71d04cea a schema:ImageObject;
