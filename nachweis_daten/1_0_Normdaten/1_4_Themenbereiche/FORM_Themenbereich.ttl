hspv:FORM-C a skos:ConceptScheme;
  skos:prefLabel "Ein-/Mehrteiligkeit"@de, "Number of parts"@en;
  skos:definition "Thesaurus: Ein-/Mehrteiligkeit (FORM-C)"@de, "Thesaurus: Number of parts (FORM-C)"@en;
  skos:inScheme hspv:FORM;
  skos:hasTopConcept hspv:FORM-C187, hspv:FORM-C102, hspv:FORM-C688 .

hspv:FORM-C187 a skos:Concept;
  skos:notation "FORM-C187";
  skos:prefLabel "einteiliges Material"@de, "material consisting of one part"@en;
  skos:definition "Material, das nur aus einem Teil besteht bzw. aus einem einzigen Entstehungszusammenhang stammt"@de;
  skos:inScheme hspv:FORM-C;
  skos:topConceptOf hspv:FORM-C .

hspv:FORM-C102 a skos:Concept;
  skos:notation "FORM-C102";
  skos:prefLabel "mehrteiliges Material"@de, "material consisting of several parts"@en;
  skos:definition "Material, das Teile aus unterschiedlichen Entstehungszusammenhängen vereint (z.B. ein Codex mit mehreren Faszikeln)."@de;
  skos:inScheme hspv:FORM-C;
  skos:topConceptOf hspv:FORM-C .

hspv:FORM-C688 a skos:Concept;
  skos:notation "FORM-C688";
  skos:prefLabel "mehrbändiges Material"@de, "material consisting of several volumes"@en;
  skos:definition "Material, das aus mehreren Bänden besteht"@de;
  skos:inScheme hspv:FORM-C;
  skos:topConceptOf hspv:FORM-C .

hspv:FORM-D a skos:ConceptScheme;
  skos:prefLabel "Gebrauchskontext"@de, "Transmission context"@en;
  skos:definition "Thesaurus: Gebrauchskontext (FORM-D)"@de, "Thesaurus: Transmission context (FORM-D)"@en;
  skos:inScheme hspv:FORM;
  skos:hasTopConcept hspv:FORM-D888, hspv:FORM-D412, hspv:FORM-D359 .

hspv:FORM-D888 a skos:Concept;
  skos:notation "FORM-D888";
  skos:prefLabel "Verwaltungsschriftgut"@de, "administrative documents"@en;
  skos:definition "Schriftgut für Verwaltungszwecke (z.B. Urkunden, Rechnungsbücher etc.)"@de;
  skos:inScheme hspv:FORM-D;
  skos:topConceptOf hspv:FORM-D .

hspv:FORM-D412 a skos:Concept;
  skos:notation "FORM-D412";
  skos:prefLabel "(Literarische) Textüberlieferung"@de, "(literary) text transmission"@en;
  skos:definition "Textüberlieferung, die nicht Verwaltungszwecken dient und daher im weitesten Sinne literarisch ist (dies umfasst sowohl wissenschaftliche und religiöse als auch im engeren Sinne literarische Überlieferung)"@de;
  skos:inScheme hspv:FORM-D;
  skos:topConceptOf hspv:FORM-D .

hspv:FORM-D359 a skos:Concept;
  skos:notation "FORM-D359";
  skos:prefLabel "Privatkorrespondenz"@de, "correspondence"@en;
  skos:altLabel "Originalkorrespondenz"@de;
  skos:definition "Originalbriefe (im Gegensatz zu Briefabschriften/Briefsammlungen)"@de;
  skos:inScheme hspv:FORM-D;
  skos:topConceptOf hspv:FORM-D .
