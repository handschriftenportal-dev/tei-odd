hspv:FORM-F a skos:ConceptScheme;
  skos:prefLabel "Fragmentierungsart und sekundärer Verwendungskontext"@de, "Fragmentation and reuse context"@en;
  skos:definition "Thesaurus: Fragmentierungsart und sekundärer Verwendungskontext (FORM-F)"@de,
    "Thesaurus: Fragmentation and reuse context (FORM-F)"@en;
  skos:inScheme hspv:FORM;
  skos:hasTopConcept hspv:FORM-F215, hspv:FORM-F796, hspv:FORM-F980, hspv:FORM-F454,
    hspv:FORM-F942, hspv:FORM-F282, hspv:FORM-F417 .

hspv:FORM-F215 a skos:Concept;
  skos:notation "FORM-F215";
  skos:prefLabel "zufällige Fragmentierung"@de, "accidental fragmentation"@en;
  skos:altLabel "Fragmentierung ex calamitate"@de, "fragmentation ex calamitate"@en;
  skos:definition "Die Fragmentierung entstand zufällig, z.B. durch Zerstörungen im Kontext von Kriegen, durch schlechte Lagerungsbedingungen u.ä."@de;
  skos:inScheme hspv:FORM-F;
  skos:topConceptOf hspv:FORM-F .

hspv:FORM-F796 a skos:Concept;
  skos:notation "FORM-F796";
  skos:prefLabel "aktiv herbeigeführte Fragmentierung"@de, "intended fragmentation"@en;
  skos:definition "Die Fragmentierung wurde bewusst und aktiv herbeigeführt, z.B. um das Material in anderen Kontexten wiederzuverwerten"@de;
  skos:inScheme hspv:FORM-F;
  skos:topConceptOf hspv:FORM-F .

hspv:FORM-F980 a skos:Concept;
  skos:notation "FORM-F980";
  skos:prefLabel "Fragmentierungsart nicht sicher zu entscheiden"@de, "unknown fragmentation cause"@en;
  skos:definition "Es ist unklar, ob die Fragmentierung zufällig geschehen oder aktiv herbeigeführt wurde"@de;
  skos:inScheme hspv:FORM-F;
  skos:topConceptOf hspv:FORM-F .

hspv:FORM-F454 a skos:Concept;
  skos:notation "FORM-F454";
  skos:prefLabel "sekundäre Verwendung in (ursprünglichen) Einzelteilen"@de, "reuse in original single parts"@en;
  skos:definition "Das fragmentierte Material wird in seinen ursprünglichen Einzelteilen in einem sekundären Kontext wiederverwendet, z.B. ausgeschnittener Buchschmuck als gerahmte Bilder"@de;
  skos:example hspv:a3793812-c8a7-4569-82c3-b174c1f381b8;
  skos:narrower hspv:FORM-F852, hspv:FORM-F739, hspv:FORM-F888, hspv:FORM-F164;
  skos:inScheme hspv:FORM-F;
  skos:topConceptOf hspv:FORM-F .

