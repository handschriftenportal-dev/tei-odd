hspv:2564ca3e-53a8-4cbe-9179-3db2399e4a62 a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00034706_00001/pct:0.11249,0.39894,99.82002,99.20213/pct:100/0/default.jpg>;
