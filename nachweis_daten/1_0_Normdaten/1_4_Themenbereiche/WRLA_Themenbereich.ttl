hspv:WRLA-A640 a skos:Concept;
  skos:notation "WRLA-A640";
  skos:prefLabel "Ostalemannisch"@de, "East Alemannic"@en;
  skos:broader hspv:WRLA-A317;
  skos:definition "Das Ostalemannische bezeichnet den Osten des alemannischen Sprachraums und kann damit auf Teile des Schwäbischen, Südalemannischen und Bodenseealemannischen verweisen. Es wird vorwiegend für Schreibsprachenbestimmungen bis zum 13. Jh. (vereinzelt noch 14. Jh.) verwendet, also für eine Zeit, in der die sprachliche Merkmalsausprägung für eine sichere Bestimmung noch nicht weit genug vorangeschritten war."@de;
  skos:inScheme hspv:WRLA-A .

hspv:WRLA-A940 a skos:Concept;
  skos:notation "WRLA-A940";
  skos:prefLabel "Niederalemannisch"@de, "Low Alemannic"@en;
  skos:broader hspv:WRLA-A317;
  skos:definition "Das Niederalemannische gehört zu einer älteren Einteilung des Alemannischen, in der zwischen Schwäbisch, Hochalemannisch und Niederalemmanisch untergliedert wurde. Dabei entspricht das Niederalemannische weitgehend dem Oberrheinischen mit Ausläufern zum Bodenseealemannischen. Vor allem in Schreibsprachenbestimmungen zu Handschriften, die vor dem 13./14. Jh. entstanden sind, findet man die Bezeichnung \"niederalemannisch\"."@de;
  skos:inScheme hspv:WRLA-A .

hspv:WRLA-A375 a skos:Concept;
  skos:notation "WRLA-A375";
  skos:prefLabel "Südalemannisch"@de, "South Alemannic"@en;
