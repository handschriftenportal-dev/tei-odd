hspv:SCRP-X334 a skos:Concept;
  skos:notation "SCRP-X334";
  skos:prefLabel "Anglicana"@de, "Anglicana"@en;
  skos:broader hspv:SCRP-X637;
  skos:definition "Die Anglicana ist ein regionaler Ausprägungsstil der älteren gotischen Kursive (als nationale Sonderform). Sie ist insbesondere in England im 14. Jh. in Gebrauch."@de;
  dct:bibliographicCitation "Albert Derolez, The palaeography of Gothic manuscript books. From the twelfth to the early sixteenth centur, Cambridge 2006, S. 134–141.";
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C439;
  skos:note "#036";
  skos:inScheme hspv:SCRP-X .

hspv:SCRP-X483 a skos:Concept;
  skos:notation "SCRP-X483";
  skos:prefLabel "Jüngere gotische Kursive"@de, "New Gothic Cursive"@en;
  skos:broader hspv:SCRP-X341;
  skos:definition "Die jüngere gotische Kursive ist die jüngere Form der gotischen Kursive. Sie ist im deutschsprachigen Raum etwa vom 3. Viertel bis zum 3. Drittel des 14. Jh. zu erwarten. Sie zeichnet sich durch einstöckigs Minuskel-a, durch unter die Grundlinie gezogenes Minuskel-s und Minuskel-f, durch Schleifen an den Langschäften von beispielsweise Minuskel-h oder Minuskel-b aus."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 63–65.";
  skos:example hspv:1532c0ed-b0d8-4db5-bc88-62b7b391151a;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C439;
  skos:note "#037";
  skos:inScheme hspv:SCRP-X .

hspv:1532c0ed-b0d8-4db5-bc88-62b7b391151a a schema:ImageObject;
  schema:contentUrl <https://dhb.thulb.uni-jena.de/api/iiif/image/v2/ufb_derivate_00014823%2FCA-4-00232_0013.tif/pct:7.55643,4.56752,81.69774,33.39327/pct:100/0/default.jpg>;
