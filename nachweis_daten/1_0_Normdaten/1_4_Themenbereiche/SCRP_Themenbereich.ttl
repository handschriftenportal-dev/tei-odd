hspv:SCRP-X565 a skos:Concept;
  skos:notation "SCRP-X565";
  skos:prefLabel "Bastarda, schleifenlos"@de, "Bastarda without loops"@en;
  skos:broader hspv:SCRP-X255;
  skos:definition "Die schleifenlose Bastarda erscheint kurz vor 1420 und wird ab dann häufiger. Sie gewann in den Niederlanden an Bedeutung und verbreitete sich von dort vor allem in den deutschen Nordwesten. Dort ist ihr Gebrauch häufiger als in anderen Regionen des deutschsprachigen Raums, was jedoch nicht ausschließt, dass die schleifenlose Bastarda beispielsweise auch in Handschriften aus Süddeutschland vorkommt. Konsequent durchgesetzt hat sie sich dort jedoch nicht."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 73–76.";
  skos:example hspv:b412d88b-a2f4-4363-9d0b-9e53e598da03;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C245;
  skos:note "#039";
  skos:inScheme hspv:SCRP-X .

