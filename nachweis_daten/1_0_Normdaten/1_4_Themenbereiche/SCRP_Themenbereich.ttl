hspv:SCRP-X549 a skos:Concept;
  skos:notation "SCRP-X549";
  skos:prefLabel "Diplomatische Minuskel"@de, "Diplomatic Minuscule"@en;
  skos:broader hspv:SCRP-X225;
  skos:definition "Die diplomatische Minuskel ist eine Ausprägungsform der karolingischen Minuskel. Sie wurde etwa ab der zweiten Hälfte des 9. Jahrhunderts in Königsurkunden verwendet. Kennzeichnend ist die kalligraphische Ausführung der Schrift in Verbindung mit Verschnörkelungen der Schaftenden und Schaftanfänge. Weitere Merkmale sind die Gitterschrift in der ersten Zeile und in der Recognitionszeile, offenes Minuskel-a, langes r sowie einige Ligaturen. In der weiteren Schriftentwicklung werden in Westauropa auch Urkundenschriften, die nicht mehr genuin auf die karolingische Minuskel als eigentliche Grundschriftart zurückgreifen, mit dem Begriff diplomatische Minuskel bezeichnet."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 170–171.";
  skos:example hspv:dfe0b43c-b564-4332-b8aa-0cd9999030b0;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792, hspv:SCRP-E778;
  skos:note "#019";
  skos:inScheme hspv:SCRP-X .

hspv:dfe0b43c-b564-4332-b8aa-0cd9999030b0 a schema:ImageObject;
