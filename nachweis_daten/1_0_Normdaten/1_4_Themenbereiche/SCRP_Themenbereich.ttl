hspv:SCRP-X825 a skos:Concept;
  skos:notation "SCRP-X825";
  skos:prefLabel "Frühkarolingische Minuskel"@de, "Early Carolingian"@en;
  skos:altLabel "Frühkarolingische Schrift"@de;
  skos:broader hspv:SCRP-X225;
  skos:definition "Innerhalb der langen Verwendungszeit der karolingischen Minuskel von über 400 Jahren lassen sich trotz des weitgehend einheitlichen Erscheinungsbild der Schriftart einige markante Unterschiede ausmachen, die es erlauben, zumindest eine frühkarolingische und die spätkarolinigische Minuskel voneinander zu scheiden. Die frühkarolingische Minuskel war ungefähr Ende des 8. und in der 1. Hälfte des 9. Jh. in Gebrauch. In dieser Zeit sind die einzelnen Wörter oft noch nicht deutlich voneinander abgetrennt (scripta continua); die Länge der Oberlängen beträgt oft mehr als die doppelte Mittelzone; außerdem sind die Oberlängen oben häufig keulenartig verdickt. Enthalten sind teilweise Ligaturen noch aus den früheren Kursiven. Ebenfalls aus den Vorformen der karolingischen Minuskel hat sich eine Zeit lang das cc-a erhalten; der untere Bogen des Minuskel-g ist groß und offen."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 151–160",
    "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 22–23.";
  skos:example hspv:43a0de2a-146f-4ca3-9f46-8d2e1bfd858c;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#016";
  skos:inScheme hspv:SCRP-X .

hspv:43a0de2a-146f-4ca3-9f46-8d2e1bfd858c a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0038/0000003891/00000004.jpx/pct:18.55066,59.86111,70.70826,26.42361/pct:100/0/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fiiif.ub.uni-leipzig.de%2F0000003891%2Fmanifest.json&page=4>;
