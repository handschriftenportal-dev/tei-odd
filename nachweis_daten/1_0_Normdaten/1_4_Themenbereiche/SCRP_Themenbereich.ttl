  schema:caption "Leipzig, UB, Fragm. lat. 201" .

hspv:SCRP-X269 a skos:Concept;
  skos:notation "SCRP-X269";
  skos:prefLabel "Gotische Schrift"@de, "Gothic Script"@en;
  skos:altLabel "Gothic Scripts"@en;
  skos:definition "Unter der Bezeichnung gotische Schrift werden die Schriften vom Ende der 2. Hälfte des 12. Jh. bis etwa zum frühen 16. Jh. zusammengefasst. Im Zuge der Gotisierung sind ihre Hauptmerkmale die Engerstellung der Schäfte und Betonung der Vertikalen, die Brechung der Schäfte auf der Grundlinie und die engere Zusammenbindung der Buchstaben (v. a. durch Bogenberührungen und Bogenverbindungen). Verwendung findet die gotische Schrift in Westeuropa."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 171–195",
    "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 28–31",
    "Karin Schneider, Gotische Schriften in deutscher Sprache, Bd. 1: Vom späten 12. Jahrhundert bis um 1300, Textband und Tafelband, Wiesbaden 1987",
    "Karin Schneider, Gotische Schriften in deutscher Sprache, Bd. 2: Die oberdeutschen Schriften von1300 bis 1350, Textband und Tafelband, Wiesbaden 2009.";
  skos:example hspv:2162c01f-2788-4405-942b-39f73bac2b5b;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155;
  skos:note "#020";
  skos:narrower hspv:SCRP-X648, hspv:SCRP-X698, hspv:SCRP-X341, hspv:SCRP-X255, hspv:SCRP-X627;
  skos:inScheme hspv:SCRP-X;
  skos:topConceptOf hspv:SCRP-X .

hspv:2162c01f-2788-4405-942b-39f73bac2b5b a schema:ImageObject;
  schema:contentUrl <https://dhb.thulb.uni-jena.de/api/iiif/image/v2/ufb_derivate_00016811%2FMemb-I-00090_00009.tif/pct:4.22136,6.0673,69.04931,30.51838/pct:100/0/default.jpg>;
