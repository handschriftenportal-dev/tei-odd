hspv:SCRP-X892 a skos:Concept;
  skos:notation "SCRP-X892";
  skos:prefLabel "Capitalis"@de, "Capitalis"@en;
  skos:altLabel "Capitalisschriften"@de, "Römische Kapitalisschriften"@de, "lateinische Capitalisschriften"@de;
  skos:definition "Die Capitalis-Schriften sind lateinische Schriften im Zweiliniensystem, d. h. aus Großbuchstaben bestehende Majuskelschriften. Als Auszeichnungsschrift werden einige von ihnen für Überschriften, Kolophone und andere Hervorhebungen bis in das Mittelalter verwendet."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 78–85",
    "David Wright, Capitalis Scripts, in: Frank T. Coulson and Robert G. Babcock (Hg.), The Oxford handbook of Latin palaeography, New York 2020, S. 79–97.";
  skos:example hspv:1c82179d-7f44-418e-bb89-20dc13d60ca2;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B884, hspv:SCRP-C792;
  skos:note "#001";
  skos:narrower hspv:SCRP-X943, hspv:SCRP-X885;
  skos:inScheme hspv:SCRP-X;
  skos:topConceptOf hspv:SCRP-X .

hspv:1c82179d-7f44-418e-bb89-20dc13d60ca2 a schema:ImageObject;
  schema:contentUrl <https://opendata.uni-halle.de//iiif-imgsrv/d2d61eed-a790-46a4-b8f9-de82873d118e/!0!16!37!21!163721501362364902897177702489319927147/pct:35.60976,18.50822,43.65854,45.49456/pct:100/0/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fopendata.uni-halle.de%2F%2Fjson%2Fiiif%2F1981185920%2F34524%2F2e11f600-b048-4528-9db5-694d4631329b%2Fmanifest&page=26>;
  schema:caption "Halle (Saale), Universitäts- und Landesbibliothek Sachsen-Anhalt, Qu. Cod. 83, fol. 12v" .

hspv:SCRP-X943 a skos:Concept;
  skos:notation "SCRP-X943";
  skos:prefLabel "Capitalis quadrata"@de, "Capitalis Quadrata"@en;
  skos:altLabel "Capitalis Quadrata"@de, "Capitalis quadrata"@en, "Square Capital"@en;
  skos:broader hspv:SCRP-X892;
  skos:definition "Die Capitalis quadrata ist die schreib- oder handschriftliche Variante der Capitalis monumentalis. Wie sie ist die Capitalis quadrata eine Majuskelschrift und in der Formgebung der Buchstaben an Quadraten ausgerichtet. Bis heute sind nur wenige Handschriften bezeugt, in denen ausschließlich die Capitalis quadrata zum Einsatz kommt, ein Beispiel ist der 'Codex Vergilius Augusteus', eine Handschrift aus der Wende vom 3. zum 4. Jahrhundert mit Werken des römischen Dichters Vergil. Bis in das Mittelalter hinein wird die Capitalis quadrata als Auszeichnungsschrift verwendet, dabei ist sie aber weit weniger häufig als die Capitalis rustica."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 78–85",
    "David Wright, Capitalis Scripts, in: Frank T. Coulson and Robert G. Babcock (Hg.), The Oxford handbook of Latin palaeography, New York 2020, S. 79–97.";
  skos:example hspv:8dbdaf25-3f96-439e-a3e3-3cefd1b5e050;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B884, hspv:SCRP-C792;
  skos:note "#002";
  skos:inScheme hspv:SCRP-X .

hspv:8dbdaf25-3f96-439e-a3e3-3cefd1b5e050 a schema:ImageObject;
  schema:contentUrl <https://opendata.uni-halle.de//iiif-imgsrv/d2d61eed-a790-46a4-b8f9-de82873d118e/!0!16!37!21!163721501362364902897177702489319927147/pct:35.60976,18.50822,43.65854,45.49456/pct:100/0/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fopendata.uni-halle.de%2F%2Fjson%2Fiiif%2F1981185920%2F34524%2F2e11f600-b048-4528-9db5-694d4631329b%2Fmanifest&page=26>;
  schema:caption "Halle (Saale), Universitäts- und Landesbibliothek Sachsen-Anhalt, Qu. Cod. 83, fol. 12v" .

hspv:SCRP-X885 a skos:Concept;
  skos:notation "SCRP-X885";
  skos:prefLabel "Capitalis rustica"@de, "Rustic Capitalis"@en;
  skos:altLabel "kanonisierte Capitalis"@de, "Capitalis Rustica"@de, "Rustic Capital"@en;
  skos:broader hspv:SCRP-X892;
  skos:definition "Als lateinische Capitalis-Schrift ist die Capitalis rustica eine Majuskelschrift, d. h. eine Schrift aus Majuskeln in einem Zweiliniensysten. Anders als bei der Capitalis quadrata passen sich die Buchstaben der Capitalis rustica jedoch nicht dem Quadrat an, sondern sind insgesamt schmaler und nach oben gelängt. Ihre Formgebung ist kurvig-bogig. Als Schrift für vollständige Codices sowie Papyri findet die Capitalis rustica vor allem vom 4. bis 5. Jh. Anwendung. Als Auszeichnungsschrift war sie mindestens bis in das 12. Jh. hinein in Gebrauch."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 78–85",
    "David Wright, Capitalis Scripts, in: Frank T. Coulson and Robert G. Babcock (Hg.), The Oxford handbook of Latin palaeography, New York 2020, S. 79–97.";
  skos:example hspv:51a1bb59-c85f-4398-9aff-11a50a7d273b;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B884, hspv:SCRP-C792;
  skos:note "#003";
  skos:inScheme hspv:SCRP-X .

hspv:51a1bb59-c85f-4398-9aff-11a50a7d273b a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00140778_00014/pct:29.49902,38.59479,49.42625,11.69623/pct:100/0/default.jpg>;
