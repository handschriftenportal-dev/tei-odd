hspv:SCRP-X637 a skos:Concept;
  skos:notation "SCRP-X637";
  skos:prefLabel "Ältere gotische Kursive"@de, "Older Gothic Cursive"@en;
  skos:broader hspv:SCRP-X341;
  skos:definition "Die ältere gotische Kursive ist die ältere Form der gotischen Kursive. Sie ist im deutschsprachigen Raum etwa vom 2. Viertel bis 2. Drittel des 14. Jh. zu erwarten. Sie zeichnet sich durch doppelstöckiges Minuskel-a, durch unter die Grundlinie gezogenes Minuskel-s und Minuskel-f, durch Schleifen an den Langschäften von beispielsweise Minuskel-h oder Minuskel-b aus; Minuskel-r kann gespalten sein; das Minuskel-s am Ende eines Wortes kann vergrößert sein."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 60–62.";
  skos:example hspv:578a10ed-4603-4403-ac3f-7a121f116330;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C439;
  skos:note "#035";
  skos:narrower hspv:SCRP-X334;
  skos:inScheme hspv:SCRP-X .

