  schema:caption "Dresden, SLUB, St. Marienthal H 1/5, fol. 2r" .

hspv:SCRP-X248 a skos:Concept;
  skos:notation "SCRP-X248";
  skos:prefLabel "Textualis"@de, "Textualis"@en;
  skos:altLabel "Textualis Libraria"@de, "Littera Gothica Textualis Libraria"@de;
  skos:broader hspv:SCRP-X648;
  skos:definition "Unter der Textualis wird die vollständig gotisierte Buchschrift vom 13. bis 15. Jh. bezeichnet. Die vom Westen her sich ausbreitende Gotisierung der Schrift setzte sich im Rheingebiet schon vor Mitte des 13. Jh., bis um 1275 fast überall im deutschen Sprachraum durch. Letzte Ausläufer der Textualis begegnen vereinzelt – vor allem in liturgischen Texten – noch im 16. Jh., in Italien (südliche Textualis) noch im 17. Jh. Je nach Ort gibt es unterschiedliche Ausprägungen der Textualis. Ganz grob wird zwischen einer nördlichen und einer südlichen Textualis unterschieden."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 171–183",
    "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 38–56.";
  skos:example hspv:a77e4cfd-ae28-41ea-95df-961a07ecc28c;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#025";
  skos:narrower hspv:SCRP-X824, hspv:SCRP-X357;
  skos:inScheme hspv:SCRP-X .

hspv:a77e4cfd-ae28-41ea-95df-961a07ecc28c a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0138/0000013834/00000128.jpx/pct:23.93229,11.19792,69.89583,28.4375/pct:100/0/default.jpg>;
