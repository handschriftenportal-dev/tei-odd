hspv:SCRP-X610 a skos:Concept;
  skos:notation "SCRP-X610";
  skos:prefLabel "Praegothica"@de, "Praegothica"@en;
  skos:broader hspv:SCRP-X648;
  skos:altLabel "Praegothic Script"@en, "Littera Praegothica"@en;
  skos:definition "Trotz variierender Ausprägungsform blieb die karolingische Schrift ca. 400 Jahre weitgehend stabil. Entscheidende Veränderung erfuhr sie durch die Gotisierung (Engerstellung der Schäfte und Betonung der Vertikalen, Brechung, engere Zusammenbindung der Buchstaben). Diese vollzog sich über einen längeren Zeitraum hinerg und mit regionalen Unterschieden. Die Schrift in dieser Transformationszeit kann am besten mit dem Begriff Praegothica bezeichnet werden. Sie tritt je nach Region vom Ende des 11. Jh. bis zum frühen 13. Jh auf. In England und Nordfrankreich sowie auf dem heutigen Gebiet Belgiens drangen als erstes Gotisierungserscheinungen in die karolingische Schrift ein. In Deutschland ist der finale Übergang zwischen beiden Schriften wohl im letzten Viertel des 12. Jh., evtl. am Anfang des 13. Jh. erfolgt."@de;
  dct:bibliographicCitation "Albert Derolez, The palaeography of Gothic manuscript books. From the twelfth to the early sixteenth centur, Cambridge 2006, S. 56–71.";
  skos:example hspv:ebdec67a-aa4a-4e6a-809f-43e91dc527d6;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#022";
  skos:narrower hspv:SCRP-X128, hspv:SCRP-X950;
  skos:inScheme hspv:SCRP-X .

hspv:ebdec67a-aa4a-4e6a-809f-43e91dc527d6 a schema:ImageObject;
  schema:contentUrl <https://api.digitale-sammlungen.de/iiif/image/v2/bsb00133567_00117/pct:5.55556,8.22954,73.90762,17.61566/pct:100/0/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fapi.digitale-sammlungen.de%2Fiiif%2Fpresentation%2Fv2%2Fbsb00133567%2Fmanifest&page=117>;
  schema:caption "München, BSB, Clm 18666, fol. 55r" .

hspv:SCRP-X128 a skos:Concept;
  skos:notation "SCRP-X128";
  skos:prefLabel "Karolingisch-gotische Übergangsschrift"@de, "Carolina-gotica"@en;
  skos:altLabel "Carolina-Gotica"@de, "Carolingian-Gothic mixed-script"@en;
  skos:broader hspv:SCRP-X610;
  skos:definition "Es gibt Schriften in der Zeit zwischen dem Ende des 11. Jh. bis zum Ende des 12. Jh., die nicht mehr als karolingisch, aber auch noch nicht als gotisch bezeichnet werden können. Sie weisen erste gotische Merkmale auf, teilweise jedoch nur in Ansätzen. Terminologisch fallen sie mit der Bezeichnung Praegothica zusammen."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 31–33.";
  skos:example hspv:391e620e-c6f4-4615-8651-10a8e5600dff;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#023";
  skos:inScheme hspv:SCRP-X .

hspv:391e620e-c6f4-4615-8651-10a8e5600dff a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0034/0000003499/00000001.jpx/pct:8.02676,10.12153,82.03536,26.00694/pct:100/0/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fiiif.ub.uni-leipzig.de%2F0000003499%2Fmanifest.json&page=1>;
  schema:caption "Leipzig, UB, Fragm. lat. 193" .

hspv:SCRP-X950 a skos:Concept;
  skos:notation "SCRP-X950";
  skos:prefLabel "Frühgotische Minuskel"@de, "Early Gothic Minuscule"@en;
  skos:broader hspv:SCRP-X610;
  skos:definition "Mit der frühgotischen Minuskel wird die gotische Minuskel in ihrer frühen Ausprägungsform verstanden. In der Regel sind hier bereits viele und wichtige Gotisierungsmerkmale vorhanden, sodass nicht mehr von einer Praegothica gesprochen werden kann. Allerdings ist bezüglich des Brechungsgrads allemal eine einfache Brechung zu erwarten; es finden sich ebenfalls noch keine Bogenverbindungen, auch nicht zwischen d und e. Je nach Region ist das Vordringen und die Entwicklung der frühgotischen Minuskel unterschiedlich ausgeprägt. Insgesamt wurde sie in der 2. Hälfte des 12. Jh. bis zur 1. Hälfte des 13. Jh. verwendet; in Deutschland am ehesten in der 1. Hälfte des 13. Jh."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 33–37.";
  skos:example hspv:bb8b8cac-9b92-430d-8047-0efbc5803f52;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#024";
  skos:inScheme hspv:SCRP-X .

hspv:bb8b8cac-9b92-430d-8047-0efbc5803f52 a schema:ImageObject;
  schema:contentUrl <https://images.iiif.slub-dresden.de/iiif/2/data%2Fkitodo%2FKapideZiA_1801043531%2FKapideZiA_1801043531_tif%2Fjpegs%2F00000007.tif.medium.jpg/pct:6.7,49.41935,74,26.70968/pct:100/0/default.jpg>;
