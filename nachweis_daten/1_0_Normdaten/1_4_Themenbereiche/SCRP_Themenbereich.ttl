hspv:SCRP-X698 a skos:Concept;
  skos:notation "SCRP-X698";
  skos:prefLabel "Halbkursive"@de, "Semi-Cursive"@en;
  skos:altLabel "Gotische Halbkursive"@de;
  skos:broader hspv:SCRP-X269;
  skos:definition "Als Halbkursive werden gotische Minunskeln bezeichnet, die bereits erste kursive Elemente aufweisen, dabei jedoch noch nicht als Kursive zu bezeichnen sind. Solche ersten kursiven Elemente können beispielsweise (leicht) unter die Grundlinie geführtes Minuskel-s oder Minuskel-f sein, erste Luftlinien in der Verbindung von zwei Buchstaben oder auch gespaltenes Minuskel-r. Im deutschsprachigen Raum kommen Halbkursiven etwa ab dem beginnenden 14. Jh. vor."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 56–59.";
  skos:example hspv:1b6c5b14-bb4c-4c75-a91b-1f167b9d06d7;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C245;
  skos:note "#033";
  skos:inScheme hspv:SCRP-X .

hspv:1b6c5b14-bb4c-4c75-a91b-1f167b9d06d7 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0044/0000004415/00000055.jpx/pct:6.16987,19.90741,35.04274,16.64886/pct:100/0/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fiiif.ub.uni-leipzig.de%2F0000004415%2Fmanifest.json&page=55>;
  schema:caption "Leipzig, UB, Ms 1509, fol. 27r" .

hspv:SCRP-X341 a skos:Concept;
  skos:notation "SCRP-X341";
  skos:prefLabel "Gotische Kursive"@de, "Gothic Cursive"@en;
  skos:broader hspv:SCRP-X269;
  skos:definition "Als gotische Kursive werden kursiv geschriebene gotische Schriften bezeichnet. Eine Kursivierung ergibt sich aus der Notwendigkeit zügiger zu schreiben. Die Buchstaben erscheinen nun – zumindest teilweise – verbunden; Minuskel-s und Minuskel-f sind regelmäßig unter die Grundlinie gezogen; Luftlinien oder Schleifen zeigen an, dass die Feder beim Übergang von einem zum anderen Buchstaben nicht mehr abgesetzt wurde und werden sollte. Erste kursive Elemente dringen Ende des 13. Jh. (Frühformen der Kursivierung aus der Urkundenschrift) und zu Beginn des 14. Jh. in Schriften (s. Halbkursiven) aus dem deutschen Raum ein. Etwa ab dem 2. Viertel des 14. Jh. sind die kursiven Elemente in den Schriften soweit vorangeschritten, dass von Kursiven gesprochen wird. Bei der gotischen Kursive wird grob in eine ältere (im deutschen Raum ca. 2. Viertel bis 2. Drittel des 14. Jh.) und in eine jüngere gotische Kursive unterteilt (im deutschen Raum ca. 3. Viertel bis 3. Drittel des 14. Jh.)."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 183–195",
    "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 56–58.";
  skos:example hspv:798a833e-1538-4afc-9210-79a9ae2d6430;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C439;
  skos:note "#034";
  skos:narrower hspv:SCRP-X637, hspv:SCRP-X483;
  skos:inScheme hspv:SCRP-X .

