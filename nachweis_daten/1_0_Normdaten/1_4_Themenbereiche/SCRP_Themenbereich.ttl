  schema:caption "Gotha, Forschungsbibliothek Gotha, Memb. I 90, fol. 2r" .

hspv:SCRP-X648 a skos:Concept;
  skos:notation "SCRP-X648";
  skos:prefLabel "Gotische Minuskel"@de, "Gothic Minuscule"@en;
  skos:altLabel "Gotische Buchschrift"@de;
  skos:broader hspv:SCRP-X269;
  skos:definition "Mit der gotischen Minuskel bezeichnet man die Ausprägungsform der gotischen Schrift, die sich als Buchschrift im Vierlinienschema bewegt, also Ober- und Unterlängen aufweist. In dieser Verwendungsweise ist der Begriff gotische Minuskel ein Oberbegriff zu den spezifizierenden Unterbegriffe wie Textualis oder Textura. Teilweise wird auf den Terminus gotische Minuskel auch zugrückgegriffen, um Schriften zu charakterisieren, die im 2. oder 3. Viertel des 13. Jh. geschrieben wurden, und noch nicht einen solch ausgeprägten Brechungsgrad aufweisen, um sie sicher als Textualis klassifizieren zu können."@de;
  dct:bibliographicCitation "Karin Schneider, Gotische Schriften in deutscher Sprache, Bd. 1: Vom späten 12. Jahrhundert bis um 1300, Textband und Tafelband, Wiesbaden 1987",
    "Karin Schneider, Gotische Schriften in deutscher Sprache, Bd. 2: Die oberdeutschen Schriften von1300 bis 1350, Textband und Tafelband, Wiesbaden 2009.";
  skos:example hspv:bd6cd311-8ac7-4582-bbce-5db2cd337a80;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#021";
  skos:narrower hspv:SCRP-X610, hspv:SCRP-X248;
  skos:inScheme hspv:SCRP-X .

