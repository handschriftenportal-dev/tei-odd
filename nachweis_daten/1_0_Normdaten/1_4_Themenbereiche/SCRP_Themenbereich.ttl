hspv:SCRP-X937 a skos:Concept;
  skos:notation "SCRP-X937";
  skos:prefLabel "Kurrente"@de, "Kurrent Script"@en;
  skos:altLabel "Currente"@de, "Kurrentschrift"@de, "Kurrent"@de, "Deutsche Schreibschrift"@de,
    "Kurrent"@en;
  skos:definition "Die Kurrentschrift entwickelte sich aus der Kanzleibastarda. Sie kam etwa ab dem frühen 16. Jh. auf. Sie ist flüssig, flach und innerhalb des Mittelbands auffallend breitgezogen. Markantes Merkmal sind die Schleifen an den Oberlängen. Die f- und s-Schäfte sind deutlich verlängert und die Buchstabenformen wie g, p oder rundes s werden in einem Federzug geschrieben. Kennbuchstabe ist das Minuskel-e, das wie geknüpft wirkt. Diese Kurrentschrift ist die Grundlage der späteren Schriften des 17. bis 19. Jh. für deutsche Texte. Ihre letzte Entwicklungsstufe wurde noch bis in die Mitte des 20. Jh. in deutschen Schulen als Grundschrift gelehrt."@de;
  dct:bibliographicCitation "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 84–86.";
  hspo:hasKeyFeature hspv:SCRP-A338, hspv:SCRP-B155, hspv:SCRP-C439;
  skos:note "#047";
  skos:narrower hspv:SCRP-X856;
  skos:inScheme hspv:SCRP-X;
  skos:topConceptOf hspv:SCRP-X .

