hspv:SCRP-X423 a skos:Concept;
  skos:notation "SCRP-X423";
  skos:prefLabel "Kanzleibastarda"@de, "Chancery Bastarda"@en;
  skos:broader hspv:SCRP-X255;
  skos:definition "In den Kanzleien des Heiligen Römischen Reichs und der Landesherrschaften wurde im 15. Jh. eine stilisierte Bastarda, die Kanzleibastarda, entwickelt und verwendet. Sie ist überindividuell und gleichmäßig: Sie hat in der Regel eine leichte Rechtsneigung im Schriftduktus, Schleifen an den Oberlängen sowie große, beinahe ausladende Anschwünge an vielen Majuskeln und Schlussbögen. Besonders markant sind s und f, die aufgrund ihrer Länge meist in die nächsten Zeilen hineinreichen, am oberen Schaft anschwellen können und nach unten hin nadelspitz auslaufen."@de;
  skos:example hspv:ea8df46e-6ad1-4728-b1d2-1a4af4afd79b;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C245;
  skos:note "#041";
  skos:inScheme hspv:SCRP-X .

