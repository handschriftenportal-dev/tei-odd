hspv:SCRP-X645 a skos:Concept;
  skos:notation "SCRP-X645";
  skos:prefLabel "Spätkarolingische Minuskel"@de, "Late Carolingian"@en;
  skos:altLabel "Spätkarolingische Schrift"@de, "Späte karolingische Minuskel"@de;
  skos:broader hspv:SCRP-X225;
  skos:definition "Innerhalb der langen Verwendungszeit der karolingischen Minuskel von über 400 Jahren lassen sich trotz des weitgehend einheitlichen Erscheinungsbild der Schriftart einige markante Unterschiede ausmachen, die es erlauben, zumindest eine frühkarolingische und die spätkarolinigische Minuskel voneinander zu scheiden. Die spätkarolingische Minuskel umfasst dabei etwa das 11. und 12. Jh. und unterscheidet sich von den Frühformen (Ende 8. Jh. und 1. Hälfte 9. Jh.) und der Hauptphase (2. Hälfte 9. Jh. und 10. Jh.). In der spätkarolingischen Minuskel sind die Oberlängen nicht mehr keulenförmig verdickt, die Schrift ordnet sich gleichmäßig im Mittelband an, wobei die Vertikale stärker betont ist als in der Frühform; das Minuskel-a richtet sich immer weiter auf, der Balken des Minuskel-e beginnt sich diagonal nach oben zu bewegen. Als spätkarolingische Minuskel wird die Phase der karolingischen Minuskel bezeichnet, bevor die Schrift durch erste Gotisierungstendenzen beeinflusst wird. Da die Gotisierung in den verschiedenen Regionen zu unterschiedlichen Zeitpunkten einsetzte, variiert auch die Zeitspanne, in der die spätkarolingische Minuskel verwendet wurde."@de;
  dct:bibliographicCitation "Bernhard Bischoff, Paläographie des römischen Altertums und des abendländischen Mittelalters. Mit einer Auswahlbibliographie 1986– 2008 von Walter Koch, 4., durchges. und erw. Auflage, Berlin 2009, S. 160–171",
    "Karin Schneider, Paläographie und Handschriftenkunde für Germanisten. Eine Einführung (Sammlung kurzer Grammatiken germanischer Dialekte B. Ergänzungsreihe Nr. 8), 3., überarbeitete Auflage, Tübingen 2013, S. 23–26.";
  skos:example hspv:5bd0d4b6-955e-4928-90f5-e2749e14d647;
  hspo:hasKeyFeature hspv:SCRP-A755, hspv:SCRP-B155, hspv:SCRP-C792;
  skos:note "#017";
  skos:narrower hspv:SCRP-X859;
  skos:inScheme hspv:SCRP-X .

hspv:5bd0d4b6-955e-4928-90f5-e2749e14d647 a schema:ImageObject;
  schema:contentUrl <https://iiif.ub.uni-leipzig.de/iiif/j2k/0000/0043/0000004368/00000002.jpx/pct:64.50321,43.96368,17.41453,19.30199/pct:100/270/default.jpg>;
  schema:identifier <https://handschriftenportal.de/workspace?type=iiif%3Amanifest&id=https%3A%2F%2Fiiif.ub.uni-leipzig.de%2F0000004368%2Fmanifest.json&page=2>;
