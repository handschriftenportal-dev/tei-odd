hspv:DECO-G772 a skos:Concept;
  skos:notation "DECO-G772";
  skos:prefLabel "über die gesamte Breite des Schriftspiegels"@de, "full-width of text area"@en;
  skos:broader hspv:DECO-G657;
  skos:altLabel "width of justification"@en;
  skos:inScheme hspv:DECO-G .

hspv:DECO-G590 a skos:Concept;
  skos:notation "DECO-G590";
  skos:prefLabel "nicht über die gesamte Breite des Schriftspiegels"@de, "not fully comprising width of text area"@en;
  skos:broader hspv:DECO-G657;
  skos:altLabel "not fully comprising width of justification"@en;
  skos:inScheme hspv:DECO-G .

hspv:DECO-G361 a skos:Concept;
  skos:notation "DECO-G361";
  skos:prefLabel "außerhalb des Schriftspiegels"@de, "in the margins"@en;
  skos:altLabel "auf den Rändern"@de, "marginal"@en, "outside text area"@en;
  skos:broader hspv:DECO-G657;
  skos:inScheme hspv:DECO-G .

hspv:DECO a skos:ConceptScheme;
  skos:prefLabel "Buchschmuck"@de, "Decoration"@en;
  skos:definition "Themenbereich: Buchschmuck"@de, "Domain: Decoration"@en;
  skos:inScheme hspv:MSVOC .

hspv:DECO-A a skos:ConceptScheme;
  skos:prefLabel "Ausführung (Buchschmuck)"@de, "Execution (decoration)"@en;
  skos:definition "Thesaurus: Ausführung (DECO-A)"@de, "Thesaurus: Execution (decoration) (DECO-A)"@en;
  skos:inScheme hspv:DECO;
  skos:hasTopConcept hspv:DECO-A405, hspv:DECO-A450 .

hspv:DECO-A405 a skos:Concept;
  skos:notation "DECO-A405";
  skos:prefLabel "Buchschmuck vorhanden"@de, "decorated; with decoration"@en;
  skos:altLabel "Ausstattung vorhanden"@de, "Buchdekor vorhanden"@de, "Dekor vorhanden"@de,
    "dekoriert"@de;
  skos:definition "Buchschmuck: Jede Art von künstlerischer oder kunsthandwerklicher Ausstattung von (besonders mittelalterlichen handgeschriebenen) Büchern, aber auch anderen Schriftstücken wie Urkunden."@de;
  dct:bibliographicCitation "Jakobi-Mirwald, 2014, 20, 21";
  skos:narrower hspv:DECO-A913, hspv:DECO-A532;
  skos:inScheme hspv:DECO-A;
  skos:topConceptOf hspv:DECO-A .

hspv:DECO-A913 a skos:Concept;
  skos:notation "DECO-A913";
  skos:prefLabel "Buchschmuck ursprünglich vorhanden"@de, "decoration originally executed"@en;
  skos:altLabel "Erstausstattung"@de, "Primärer Buchschmuck"@de;
  skos:broader hspv:DECO-A405;
  skos:definition "Zeitnah zur Entstehung der Handschrift ausgeführter Buchschmuck, der in der Regel bei deren Einrichtung vorgesehen war (ausgesparte Räume im Schriftspiegel)."@de;
  skos:narrower hspv:DECO-A369, hspv:DECO-A449;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A369 a skos:Concept;
  skos:notation "DECO-A369";
  skos:prefLabel "Buchschmuck ursprünglich teilweise ausgeführt"@de, "decoration originally partly executed"@en;
  skos:broader hspv:DECO-A913;
  skos:definition "Bei der Einrichtung der Handschrift vorgesehener Buchschmuck nicht vollständig ausgeführt, erkennbar durch Lücken im Layout, bzw. im Schriftspiegel"@de;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A449 a skos:Concept;
  skos:notation "DECO-A449";
  skos:prefLabel "Buchschmuck ursprünglich vollständig ausgeführt"@de, "decoration originally fully executed"@en;
  skos:broader hspv:DECO-A913;
  skos:definition "Bei der Einrichtung der Handschrift vorgesehener Buchschmuck vollständig ausgeführt"@de;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A532 a skos:Concept;
  skos:notation "DECO-A532";
  skos:prefLabel "nachträglicher Buchschmuck"@de, "later decoration"@en;
  skos:altLabel "Sekundärer Buchschmuck"@de, "added decoration"@en;
  skos:broader hspv:DECO-A405;
  skos:definition "Bei der Einrichtung der Handschrift vorgesehener, aber erst zu einem späteren Zeitpunkt, beispielsweise im Auftrag eines späteren Besitzers, ausgeführter Buchschmuck bzw. nachträglich hinzugefügter, ursprünglich nicht vorgesehener Buchschmuck, wie z.B. in Einbanddeckel eingeklebte Graphik"@de;
  skos:narrower hspv:DECO-A790, hspv:DECO-A904;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A790 a skos:Concept;
  skos:notation "DECO-A790";
  skos:prefLabel "nachträglicher Buchschmuck teilweise ausgeführt"@de, "later decoration partly executed"@en;
  skos:broader hspv:DECO-A532;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A904 a skos:Concept;
  skos:notation "DECO-A904";
  skos:prefLabel "nachträglicher Buchschmuck vollständig ausgeführt"@de, "later decoration fully executed"@en;
  skos:broader hspv:DECO-A532;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A450 a skos:Concept;
  skos:notation "DECO-A450";
  skos:prefLabel "Buchschmuck nicht vorhanden"@de, "not illuminated"@en;
  skos:narrower hspv:DECO-A980, hspv:DECO-A886;
  skos:inScheme hspv:DECO-A;
  skos:topConceptOf hspv:DECO-A .

hspv:DECO-A980 a skos:Concept;
  skos:notation "DECO-A980";
  skos:prefLabel "Buchschmuck nicht ausgeführt"@de, "decoration not executed"@en;
  skos:broader hspv:DECO-A450;
  skos:definition "Bei der Einrichtung der Handschrift vorgesehener Buchdekor (Initialen, Bilder) wurde in den dafür eingerichteten bzw. im Schriftspiegel ausgesparten Feldern nicht ausgeführtt, erkennbar durch Lücken im Layout, bzw. im Schriftspiegel"@de;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A886 a skos:Concept;
  skos:notation "DECO-A886";
  skos:prefLabel "Buchschmuck entfernt"@de, "decoration removed"@en;
  skos:broader hspv:DECO-A450;
  skos:definition "Zu entferntem Buchschmuck gehören herausgeschnittene Bilder und Initialen der ursprünglichen Ausstattung oder eingeklebte Bilder, von denen of Klebespuren zurückgeblieben sind."@de;
  skos:narrower hspv:DECO-A226, hspv:DECO-A414;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A226 a skos:Concept;
  skos:notation "DECO-A226";
  skos:prefLabel "Buchschmuck vollständig entfernt"@de, "decoration partly removed"@en;
  skos:broader hspv:DECO-A886;
  skos:definition "Bilder und Initialen der ursprünglichen Ausstattung oder eingeklebte Bilder vollständig entfernt"@de;
  skos:inScheme hspv:DECO-A .

hspv:DECO-A414 a skos:Concept;
  skos:notation "DECO-A414";
  skos:prefLabel "Buchschmuck teilweise entfernt"@de, "decoration fully removed"@en;
  skos:broader hspv:DECO-A886;
  skos:definition "Bilder und Initialen der ursprünglichen Ausstattung oder eingeklebte Bilder vollständig entfernt"@de;
  skos:inScheme hspv:DECO-A .

