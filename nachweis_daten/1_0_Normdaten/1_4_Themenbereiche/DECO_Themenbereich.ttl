hspv:DECO-X370 a skos:Concept;
  skos:notation "DECO-X370";
  skos:prefLabel "Deckfarbenmalerei"@de, "book painting in opaque colours"@en;
  skos:altLabel "Illuminierung"@de, "Buchmalerei"@de, "book illumination in gouache"@en,
    "book illumination in opaque colours"@en;
  skos:definition "Malereitechnik mit einer oder mehreren übereinandergelegten opaken Farbschichten, bei der nachträglich Lichter aufgesetzt und Konturen nachgezogen werden (Köllner 141). Der Gegensatz zur deckenden Malerei ist die lasierende Malerei, die Malerei mit einer oder mehreren transparenten Farbschichten (Lasuren). Bei transparent-wässrigem Farbauftrag über Zeichnungen spricht man von Lavierung. Mittelalterliche Rezeptbücher unterscheiden bei der Ausstattung zweierlei Arten von Farbauftrag: das Korporieren mit gröberen Pigmentpartikeln, z. B. für Buchstabenkörper, und das Florieren oder Musieren mit dünnerer Farbe, z. B. bei Fleuronné (Liber illuministarum, 614 ff)."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 110";
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-C417, hspv:DECO-D772;
  skos:inScheme hspv:DECO-X;
  skos:topConceptOf hspv:DECO-X .

hspv:DECO-X724 a skos:Concept;
  skos:notation "DECO-X724";
  skos:prefLabel "Aquarell"@de, "book painting in water colour"@en;
  skos:altLabel "Wasserfarbenmalerei"@de, "book illumination in water colour"@en;
  skos:definition "Malerei in transparentem Farbauftrag mit nicht-deckenden Wasserfarben. Reine Aquarellmalerei lässt im Gegensatz Gouache und Tempera den Malgrund durchscheinen"@de;
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-C247, hspv:DECO-D772;
  skos:inScheme hspv:DECO-X;
  skos:topConceptOf hspv:DECO-X .

hspv:DECO-X419 a skos:Concept;
  skos:notation "DECO-X419";
  skos:prefLabel "Miniatur"@de, "miniature"@en;
  skos:definition "Alle selbständigen, d. h. nicht an Initialen gebundenen figürlichen Buchmalereien in Deckfarben – gerahmt oder ungerahmt, in der Kolumne oder am Rand. Miniaturen unterscheiden sich nach technischer Ausführung, Gliederungsschema und Beschaffenheit des Grundes. Der Begriff Miniatur wird zuweilen fälschlicherweise für alle Bilder in Handschriften verwendet."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 2014, 23";
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-B604, hspv:DECO-D772, hspv:DECO-H751;
  skos:inScheme hspv:DECO-X;
  skos:topConceptOf hspv:DECO-X .

hspv:DECO-X840 a skos:Concept;
  skos:notation "DECO-X840";
  skos:prefLabel "Zeichnung"@de, "drawing"@en;
  skos:definition "Zu unterscheiden ist nach dem verwendeten Werkzeug (Feder, Pinsel, Griffel), und danach, ob es sich um eine (unvollendete) Vorzeichnung oder eine Zeichnung in eigenem Recht handelt. Zeichnungen rangieren von der nachträglichen autonomen Zeichnung außerhalb der geplanten Buchausstattung bis zum ganzseitigen Bild. Zeichnung kann in verschiedenen Farben ausgeführt sein (meist braun und rot) und mit Farbe ausgestattet werden."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 111";
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-D331;
  skos:narrower hspv:DECO-X710, hspv:DECO-X480, hspv:DECO-X230, hspv:DECO-X665, hspv:DECO-X493;
  skos:inScheme hspv:DECO-X;
  skos:topConceptOf hspv:DECO-X .

hspv:DECO-X710 a skos:Concept;
  skos:notation "DECO-X710";
  skos:prefLabel "Federzeichnung"@de, "pen drawing"@en;
  skos:altLabel "mit Feder"@de;
  skos:broader hspv:DECO-X840;
  skos:definition "Mit Feder und Tinte ausgeführte Zeichnung"@de;
  dct:bibliographicCitation "Jakobi-Mirwald 111";
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-C668, hspv:DECO-D783;
  skos:narrower hspv:DECO-X495, hspv:DECO-X331;
  skos:inScheme hspv:DECO-X .

hspv:DECO-X495 a skos:Concept;
  skos:notation "DECO-X495";
  skos:prefLabel "lavierte Federzeichnung"@de, "wash (pen drawing)"@en;
  skos:broader hspv:DECO-X710;
  skos:altLabel "tinted pen drawing"@en;
  skos:definition "Oft modellierend aufgetrager, transparent-wässriger Farbauftrag über Zeichnungen"@de;
  dct:bibliographicCitation "Jakobi-Mirwald 111, vgl. Köllner 1963, 141";
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-C668, hspv:DECO-C247, hspv:DECO-D783,
