  skos:altLabel "Initiale mit Initialfeld auf Grund"@de;
  skos:broader hspv:DECO-H819;
  skos:definition "Initiale auf einem gestalteten oder gerahmten oder konturierten Feld mit gefärbtem oder gestaltetem Grund"@de;
  skos:inScheme hspv:DECO-H .

