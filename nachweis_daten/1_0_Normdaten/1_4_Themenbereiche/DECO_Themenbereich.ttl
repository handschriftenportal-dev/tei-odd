  skos:inScheme hspv:DECO-X .

hspv:DECO-X331 a skos:Concept;
  skos:notation "DECO-X331";
  skos:prefLabel "kolorierte Federzeichnung"@de, "coloured pen drawing"@en;
  skos:broader hspv:DECO-X710;
  skos:definition "Kolorierungen werden oft großflächig und ohne Modellierung mit transparentem oder deckendem Farbauftrag ausgeführt. Die Unterscheidung zur Lavierungng ist fließend (vgl. Köllner 141)."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 111, vgl. Köllner 1963, 141";
  hspo:hasKeyFeature hspv:DECO-A405, hspv:DECO-C668, hspv:DECO-D783;
