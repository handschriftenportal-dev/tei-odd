  skos:inScheme hspv:DECO-H .

hspv:DECO-H549 a skos:Concept;
  skos:notation "DECO-H549";
  skos:prefLabel "runder Rahmen"@de, "circular frame"@en;
  skos:altLabel "Rahmen rund"@de, "Medaillonrahmen"@de, "round frame"@en, "medaillon frame"@en;
  skos:broader hspv:DECO-H333;
  skos:inScheme hspv:DECO-H .

hspv:DECO-H349 a skos:Concept;
  skos:notation "DECO-H349";
  skos:prefLabel "Architekturrahmen"@de, "architectural frame"@en;
  skos:altLabel "architektonischer Rahmen"@de;
  skos:broader hspv:DECO-H333;
  skos:definition "Allgemeiner Begriff für Rahmen mit oder in Form von architektonischen Versatzstücken (z. B. in Ädikulaform, mit Säulen als vertikale Begrenzung, mit Haus- und Stadtformen am oberen Rahmenrand, bisweilen mit stilisierten Darstellungen bestimmter Örtlichkeiten). Vorhangmotiv siehe → Baldachinrahmen."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 2014, 80";
  skos:inScheme hspv:DECO-H .

hspv:DECO-H555 a skos:Concept;
  skos:notation "DECO-H555";
  skos:prefLabel "sonstige Rahmenform"@de, "other type of frame"@en;
  skos:broader hspv:DECO-H333;
  skos:inScheme hspv:DECO-H .

hspv:DECO-H386 a skos:Concept;
  skos:notation "DECO-H386";
