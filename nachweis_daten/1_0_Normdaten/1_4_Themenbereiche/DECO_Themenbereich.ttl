hspv:DECO-G a skos:ConceptScheme;
  skos:prefLabel "Dekor im Layout"@de, "Decoration layout"@en;
  skos:definition "Thesaurus: Dekor im Layout (DECO-G)"@de, "Thesaurus: Decoration layout (DECO-G)"@en;
  skos:inScheme hspv:DECO;
  skos:hasTopConcept hspv:DECO-G949, hspv:DECO-G657 .

hspv:DECO-G949 a skos:Concept;
  skos:notation "DECO-G949";
  skos:prefLabel "unabhängig vom Schriftspiegel"@de, "independent of text area"@en;
  skos:narrower hspv:DECO-G355, hspv:DECO-G289;
  skos:inScheme hspv:DECO-G;
  skos:topConceptOf hspv:DECO-G .

hspv:DECO-G355 a skos:Concept;
  skos:notation "DECO-G355";
  skos:prefLabel "ganzseitig"@de, "full-page"@en;
  skos:broader hspv:DECO-G949;
  skos:definition "Die gesamte Seite oder mindestens den ganzen Schriftspiegel (z.B. ganzseitige Miniatur) einnehmender Dekor."@de;
  skos:inScheme hspv:DECO-G .

hspv:DECO-G289 a skos:Concept;
  skos:notation "DECO-G289";
  skos:prefLabel "nicht ganzseitig"@de, "not full-page"@en;
  skos:broader hspv:DECO-G949;
  skos:inScheme hspv:DECO-G .

hspv:DECO-G657 a skos:Concept;
  skos:notation "DECO-G657";
  skos:prefLabel "mit Bezug auf den Schriftspiegel"@de, "relating to text area"@en;
  skos:altLabel "relating to bounding lines"@en, "relating to ruling lines"@en, "relating to justification"@en;
  skos:narrower hspv:DECO-G699, hspv:DECO-G772, hspv:DECO-G590, hspv:DECO-G361;
  skos:inScheme hspv:DECO-G;
  skos:topConceptOf hspv:DECO-G .

hspv:DECO-G699 a skos:Concept;
  skos:notation "DECO-G699";
  skos:prefLabel "den gesamten Schriftspiegel umfassend"@de, "comprising text area"@en;
  skos:broader hspv:DECO-G657;
  skos:altLabel "comprising justification"@en;
