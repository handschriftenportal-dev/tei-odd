  skos:altLabel "picture"@en;
  skos:inScheme hspv:DECO-H .

hspv:DECO-H732 a skos:Concept;
  skos:notation "DECO-H732";
  skos:prefLabel "Schema"@de, "diagram"@en;
  skos:altLabel "Diagramme"@de, "chart"@en;
  skos:definition "Graphisches Hilfsmittel zur Verdeutlichung abstrakter Inhalte oder naturwissenschaftlicher Sachverhalte. Dazu gehören auch Stammbäume (arbores consanguinitatis, oder affinitatis), astronomische, komputistische oder geometrische Figuren, medizinische Diagramme. Schemata können ornamental und figürlich ausgestaltet werden und ganze Zierseiten bilden."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 2014, 31";
  skos:inScheme hspv:DECO-H;
  skos:topConceptOf hspv:DECO-H .

hspv:DECO-H637 a skos:Concept;
  skos:notation "DECO-H637";
  skos:prefLabel "Zierschrift"@de, "decorative script"@en;
  skos:inScheme hspv:DECO-H;
  skos:topConceptOf hspv:DECO-H .

