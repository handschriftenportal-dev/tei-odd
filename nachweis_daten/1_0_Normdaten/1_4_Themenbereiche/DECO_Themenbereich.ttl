  skos:altLabel "vine-scroll"@en;
  skos:inScheme hspv:DECO-H;
  skos:topConceptOf hspv:DECO-H .

hspv:DECO-H516 a skos:Concept;
  skos:notation "DECO-H516";
  skos:prefLabel "selbstständige Darstellung"@de, "autonomous image"@en;
  skos:altLabel "autonome Darstellung"@de, "autonomous depiction"@en;
