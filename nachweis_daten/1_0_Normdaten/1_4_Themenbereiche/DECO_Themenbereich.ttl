  skos:altLabel "Initiale mit Initialfeld ohne Grund"@de;
  skos:broader hspv:DECO-H819;
  skos:definition "Initiale auf einem nicht gestalteten oder gefärbtem gerahmten oder konturierten Feld"@de;
  skos:inScheme hspv:DECO-H .

hspv:DECO-H491 a skos:Concept;
