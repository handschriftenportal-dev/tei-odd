  skos:broader hspv:DECO-H723;
  skos:definition "Initiale auf einem fest begrenzten Feld, häufig konturiert oder gerahmt"@de;
  dct:bibliographicCitation "Jakobi-Mirwald 2014, 62, 83";
  skos:narrower hspv:DECO-H141, hspv:DECO-H491;
  skos:inScheme hspv:DECO-H .

