  skos:inScheme hspv:DECO-E;
  skos:topConceptOf hspv:DECO-E .

hspv:DECO-E490 a skos:Concept;
  skos:notation "DECO-E490";
  skos:prefLabel "zweifarbig (Buchschmuck)"@de, "dichromatic (decoration)"@en;
  skos:broader hspv:DECO-E546;
  skos:altLabel "bicolour (decoration)"@en;
  skos:inScheme hspv:DECO-E .

hspv:DECO-E772 a skos:Concept;
  skos:notation "DECO-E772";
  skos:prefLabel "dreifarbig (Buchschmuck)"@de, "three-coloured (decoration)"@en;
  skos:broader hspv:DECO-E546;
  skos:altLabel "trichromatic (decoration)"@en;
  skos:inScheme hspv:DECO-E .

hspv:DECO-E784 a skos:Concept;
  skos:notation "DECO-E784";
  skos:prefLabel "vierfarbig (Buchschmuck)"@de, "four-coloured (decoration)"@en;
  skos:broader hspv:DECO-E546;
  skos:inScheme hspv:DECO-E .

hspv:DECO-E769 a skos:Concept;
  skos:notation "DECO-E769";
  skos:prefLabel "mehr als vier Farben (Buchschmuck)"@de, "more than four colours (decoration)"@en;
  skos:broader hspv:DECO-E546;
  skos:inScheme hspv:DECO-E .

hspv:DECO-B a skos:ConceptScheme;
  skos:prefLabel "Gestaltungstyp"@de, "Decoration type"@en;
  skos:definition "Thesaurus: Gestaltungstyp (DECO-B)"@de, "Thesaurus: Decoration type (DECO-B)"@en;
  skos:inScheme hspv:DECO;
  skos:hasTopConcept hspv:DECO-B186, hspv:DECO-B604, hspv:DECO-B512 .

hspv:DECO-B186 a skos:Concept;
  skos:notation "DECO-B186";
  skos:prefLabel "ornamental"@de, "ornamental"@en;
  skos:definition "Im Gegensatz zu gegenständlich oder illustrierend: jegliche Art von Darstellung ohne inhaltlichen Bezug (z. B. ornamentale Initialen im Gegensatz zu historisierten), nichtfigürliche, vegetabilische, zoomorphe oder geometrische Motivik"@de;
  dct:bibliographicCitation "Jakobi-Mirwald, 2014, 22";
  skos:narrower hspv:DECO-B997, hspv:DECO-B191;
  skos:inScheme hspv:DECO-B;
  skos:topConceptOf hspv:DECO-B .

hspv:DECO-B997 a skos:Concept;
  skos:notation "DECO-B997";
  skos:prefLabel "vegetabil"@de, "phytomorphic"@en;
  skos:broader hspv:DECO-B186;
  skos:altLabel "vegetal"@en;
  skos:definition "ornamentale Gestaltung mit vegetabilen Elementen"@de;
  skos:inScheme hspv:DECO-B .

hspv:DECO-B191 a skos:Concept;
  skos:notation "DECO-B191";
  skos:prefLabel "geometrisch"@de, "geometric"@en;
  skos:broader hspv:DECO-B186;
  skos:altLabel "geometrical"@en;
  skos:definition "ornamentale Gestaltung mit vegetabilen Elementen"@de;
  skos:inScheme hspv:DECO-B .

hspv:DECO-B604 a skos:Concept;
  skos:notation "DECO-B604";
  skos:prefLabel "gegenständlich"@de, "representational"@en;
  skos:definition "gegenständliche Gestaltung auch ohne illustrierende Funktion"@de;
  skos:narrower hspv:DECO-B598;
  skos:inScheme hspv:DECO-B;
  skos:topConceptOf hspv:DECO-B .

hspv:DECO-B598 a skos:Concept;
  skos:notation "DECO-B598";
  skos:prefLabel "figürlich"@de, "figurative"@en;
  skos:broader hspv:DECO-B604;
  skos:definition "Menschen- und Tierdarstellungen umfassend"@de;
  dct:bibliographicCitation "Jakobi-Mirwald, 2014, 20";
  skos:narrower hspv:DECO-B320, hspv:DECO-B961;
  skos:inScheme hspv:DECO-B .

hspv:DECO-B320 a skos:Concept;
  skos:notation "DECO-B320";
  skos:prefLabel "zoomorph"@de, "zoomorphic"@en;
  skos:broader hspv:DECO-B598;
  skos:definition "Tierdarstellungen umfassend"@de;
  skos:inScheme hspv:DECO-B .

hspv:DECO-B961 a skos:Concept;
  skos:notation "DECO-B961";
  skos:prefLabel "anthropomorph"@de, "anthropomorphic"@en;
  skos:broader hspv:DECO-B598;
  skos:definition "Menschendarstellungen umfassend"@de;
  skos:inScheme hspv:DECO-B .

hspv:DECO-B512 a skos:Concept;
  skos:notation "DECO-B512";
  skos:prefLabel "Sonstiger Gestaltungstyp"@de, "other type of decoration"@en;
  skos:inScheme hspv:DECO-B;
  skos:topConceptOf hspv:DECO-B .

hspv:DECO-C a skos:ConceptScheme;
  skos:prefLabel "Material (Buchschmuck)"@de, "Material (decoration)"@en;
  skos:definition "Thesaurus: Material (Buchschmuck) (DECO-C)"@de, "Thesaurus: Material (decoration) (DECO-C)"@en;
  skos:inScheme hspv:DECO;
  skos:hasTopConcept hspv:DECO-C491, hspv:DECO-C745, hspv:DECO-C462, hspv:DECO-C394,
    hspv:DECO-C429, hspv:DECO-C592, hspv:DECO-C665, hspv:DECO-C257 .

hspv:DECO-C491 a skos:Concept;
  skos:notation "DECO-C491";
  skos:prefLabel "Farbmaterial"@de, "colour material"@en;
  skos:definition "In Wasser suspendierbare Farbe aus Pigmenten und Füllstoffen, die auf den Untergrund sattdeckend aufgetragen werden kann"@de;
  skos:narrower hspv:DECO-C668, hspv:DECO-C417, hspv:DECO-C916, hspv:DECO-C247;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C668 a skos:Concept;
  skos:notation "DECO-C668";
  skos:prefLabel "Tinte"@de, "ink"@en;
  skos:broader hspv:DECO-C491;
  skos:definition "In der Handschriftenherstellung werden verschiedene Tinten verwendet, vornehmlich als Schreibmittel und für die Rubrizierung, aber auch für Buchschmuck. Verwendet wurde Dornentinte aus der mit Wein gekochten Rinde von Dornensträuchern, teilweise mit Ruß abgedunkelt, Eisengallustinte/Kupfergallustinte aus Metallsalzen, Gebstoffen (Galläpfeln) und Bindemitteln (z.B. Gummi arabicum), Metalltinte (z.B. Silber oder Gold), ronte Tinte aus Minium oder Zinnober oder Rußtinte (Tusche)."@de;
  skos:inScheme hspv:DECO-C .

hspv:DECO-C417 a skos:Concept;
  skos:notation "DECO-C417";
  skos:prefLabel "Deckfarbe"@de, "opaque colours"@en;
  skos:broader hspv:DECO-C491;
  skos:altLabel "gouache"@en;
  skos:definition "Malereitechnik mit einer oder mehreren übereinandergelegten opaken Farbschichten, bei der nachträglich Lichter aufgesetzt und Konturen nachgezogen werden (Köllner 141). Der G egensatz zur deckenden Malerei ist die lasierende Malerei mit einer oder mehreren transparenten Farbschichten (Lasuren). Bei transparent-wässrigem Farbauftrag über Zeichnungen spricht man von Lavierung. Mittelalterliche Rezeptbücher unterscheiden bei der Ausstattung zweierlei Arten von Farbauftrag: das Korporieren mit gröberen Pigmentpartikeln, z. B. für Buchstabenkörper, und das Florieren oder Musieren mit dünnerer Farbe, z. B. bei Fleuronné (Liber illuministarum)."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 110";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C916 a skos:Concept;
  skos:notation "DECO-C916";
  skos:prefLabel "Druckfarbe"@de, "print colours"@en;
  skos:broader hspv:DECO-C491;
  skos:altLabel "printing ink"@en;
  skos:definition "Tinten dienten vornehmlich für die Schrift und Rubrizierung sowie manche Dekortypen, wie z.B. Fleuronnée. Bekannt sind Dornentinte (mit Beigabe von Eisen, Ruß oder Vitriol; H. Roosen-Runge: Die T inte des T heophilus, in: F S Luitpold Duss ler, München 1972, 87–112), Eisengallustinte, Kupfergallustinte sowie Metallemulsionen aus pulverisiertem Metall und Bindemittel."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 110";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C247 a skos:Concept;
  skos:notation "DECO-C247";
  skos:prefLabel "Wasserfarbe"@de, "watercolour"@en;
  skos:broader hspv:DECO-C491;
  skos:definition "Verwendung von wasserlöslichen Farbmitteln oder Farbmittel nmit wasserlöslichen Bindemitteln. Charakteristisch ist der transparente Farbauftrag."@de;
  skos:inScheme hspv:DECO-C .

hspv:DECO-C745 a skos:Concept;
  skos:notation "DECO-C745";
  skos:prefLabel "Metall (Buchschmuck)"@de, "metal (book decoration)"@en;
  skos:definition "Im Buchschmuck wurden Metalle (vornehmlich Gold und Silber) in Form von Metallfolien (Blattgold, Blattsilber) oder Metallemulsionen auch in Mischungen verwendet (z.B. Pinselgold/Muschelgold)"@de;
  skos:narrower hspv:DECO-C153, hspv:DECO-C490, hspv:DECO-C588, hspv:DECO-C330;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C153 a skos:Concept;
  skos:notation "DECO-C153";
  skos:prefLabel "Silber (Buchschmuck)"@de, "silver (book decoration)"@en;
  skos:broader hspv:DECO-C745;
  skos:definition "Im Buchschmuck wurden Metalle (vornehmlich Gold und Silber) in Form von Metallfolien (Blattgold, Blattsilber) oder Metallemulsionen auch in Mischungen verwendet (z.B. Pinselgold/Muschelgold)"@de;
  skos:narrower hspv:DECO-C302, hspv:DECO-C401;
  skos:inScheme hspv:DECO-C .

hspv:DECO-C302 a skos:Concept;
  skos:notation "DECO-C302";
  skos:prefLabel "Blattsilber (Buchschmuck)"@de, "silver leaf (book decoration)"@en;
  skos:broader hspv:DECO-C153;
  skos:definition "Sehr dünn ausgetriebene Silberfolien, die mit einem Anlegemittel (meist Eikläre) direkt oder auf eine z. T . erhabene Gipsgrundierung (Gesso) aufgelegt und anschließend poliert oder auch weiter verziert werden. (Silbergrund). Gründe, Schriften oder Ornamente aus Silber sind im Gegensatz zum Gold sehr anfällig: sie sulfidieren (nehmen Schwefel aus der Luft auf), d. h. werden schwarz; je nach verwendetem Bindemittel laufen sie aus und schlagen auf die R ückseite durch. Gold schlägt nur durch, wenn es Kupfer oder andere Streckmittel enthält"@de;
  skos:inScheme hspv:DECO-C .

hspv:DECO-C401 a skos:Concept;
  skos:notation "DECO-C401";
  skos:prefLabel "Pinselsilber (Buchschmuck)"@de, "silver emulsion"@en;
  skos:altLabel "Silberemulsion"@de, "Silberpulver"@de;
  skos:broader hspv:DECO-C153;
  skos:definition "Pulverisiertes Silber, das mit einem Bindemittel (Gummi oder Eikläre) mit dem Pinsel oder als Tinte verarbeitet wird. Die Bezeichnung Muschelgold rührt daher, dass die fertige Emulsion in den Innenseiten von Muschelschalen vertrieben wurde"@de;
  dct:bibliographicCitation "Jakobi-Mirwald 117";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C490 a skos:Concept;
  skos:notation "DECO-C490";
  skos:prefLabel "Gold (Buchschmuck)"@de, "gold (book decoration)"@en;
  skos:broader hspv:DECO-C745;
  skos:definition "Im Buchschmuck wurden Metalle (vornehmlich Gold und Silber) in Form von Metallfolien (Blattgold, Blattsilber) oder Metallemulsionen auch in Mischungen verwendet (z.B. Pinselgold/Muschelgold)"@de;
  skos:narrower hspv:DECO-C459, hspv:DECO-C135;
  skos:inScheme hspv:DECO-C .

hspv:DECO-C459 a skos:Concept;
  skos:notation "DECO-C459";
  skos:prefLabel "Blattgold (Buchschmuck)"@de, "gold leaf (book decoration)"@en;
  skos:broader hspv:DECO-C490;
  skos:altLabel "mordant gilding"@en, "burnished gold"@en;
  skos:definition "Sehr dünn ausgetriebene Goldfolien, die mit einem Anlegemittel (meist Eikläre) direkt oder auf eine z. T . erhabene Gipsgrundierung (Gesso) aufgelegt und anschließend poliert oder auch weiter verziert werden. (Goldgrund). Wie unter anderem aus unvollendeten Handschriften deutlich wird, war die Vergoldung stets der erste Arbeitsschrift der farbigen Ausstattung. Mit bloßem Auge kann nicht immer zwischen Blatt- und Pinselgold (Goldemulsion) unterschieden werden. Blattgold findet vor allem ab der 2. Hälfte des 12. Jh. verstärkt Verwendung."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 115-116";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C135 a skos:Concept;
  skos:notation "DECO-C135";
  skos:prefLabel "Pinselgold (Buchschmuck)"@de, "gold emulsion"@en;
  skos:altLabel "Goldemulsion"@de, "Muschelgold"@de, "Goldpulver"@de;
  skos:broader hspv:DECO-C490;
  skos:definition "Fein vermahlenes Blattgold, das mit einem Bindemittel (Gummi oder Eikläre) mit dem Pinsel oder als Tinte verarbeitet wird. Die Bezeichnung Muschelgold rührt daher, dass die fertige Emulsion in den Innenseiten von Muschelschalen vertrieben wurde"@de;
  dct:bibliographicCitation "Jakobi-Mirwald 116";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C588 a skos:Concept;
  skos:notation "DECO-C588";
  skos:prefLabel "Blei"@de, "lead"@en;
  skos:broader hspv:DECO-C745;
  skos:definition """Zeichnungen, auch Vorzeichnungen und Liniierungen Vorzeichnungen oder Liniierung wurden häufig mit einem
Metallgriffel, vorwiegend Blei, ausgeführt. Ebenso fand Blei für die Herstellung des wichtigsten weißen Pigments (Bleiweiß, cerus[s]a, album plumbum; Bleicarbonat, seit der
Antike aus Blei und Essig oder Urin) Verwendung basisches"""@de;
  dct:bibliographicCitation "Jakobi-Mirwald 119, 112";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C330 a skos:Concept;
  skos:notation "DECO-C330";
  skos:prefLabel "Sonstiges Metall (Buchschmuck)"@de, "other metal (book decoration)"@en;
  skos:broader hspv:DECO-C745;
  skos:definition """Verwendung eines Blindgriffels, Stylus, der 
 eine Einkerbung, aber keinefarbige Spur
hinterlässt."""@de;
  dct:bibliographicCitation "Jakobi-Mirwald 118";
  skos:inScheme hspv:DECO-C .

hspv:DECO-C462 a skos:Concept;
  skos:notation "DECO-C462";
  skos:prefLabel "Graphit"@de, "graphite"@en;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C394 a skos:Concept;
  skos:notation "DECO-C394";
  skos:prefLabel "Kohle"@de, "coal"@en;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C429 a skos:Concept;
  skos:notation "DECO-C429";
  skos:prefLabel "Kreide"@de, "chalk"@en;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C592 a skos:Concept;
  skos:notation "DECO-C592";
  skos:prefLabel "Rötel"@de, "red chalk"@en;
  skos:altLabel "roter Ocker"@de, "Rötelstein"@de;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C665 a skos:Concept;
  skos:notation "DECO-C665";
  skos:prefLabel "blind"@de, "executed without material"@en;
  skos:altLabel "blind ausgeführt"@de, "ohne Material ausgeführt"@de, "dry-point"@en;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .

hspv:DECO-C257 a skos:Concept;
  skos:notation "DECO-C257";
  skos:prefLabel "mit sonstigem Material ausgeführt"@de, "executed in other material"@en;
  skos:inScheme hspv:DECO-C;
  skos:topConceptOf hspv:DECO-C .
