hspv:DECO-H a skos:ConceptScheme;
  skos:prefLabel "Grundelemente (Buchschmuck)"@de, "Basic elements (decoration)"@en;
  skos:definition "Thesaurus: Grundelemente Buchschmuck (DECO-H)"@de, "Thesaurus: Basic elements (decoration) (DECO-H)"@en;
  skos:inScheme hspv:DECO;
  skos:hasTopConcept hspv:DECO-H723, hspv:DECO-H840, hspv:DECO-H333, hspv:DECO-H386,
    hspv:DECO-H516, hspv:DECO-H732, hspv:DECO-H637 .

hspv:DECO-H723 a skos:Concept;
  skos:notation "DECO-H723";
  skos:prefLabel "Initiale"@de, "initial"@en;
  skos:altLabel "(Schmuck-)initiale"@de, "Schmuckinitiale"@de, "Schmuckinitialen"@de;
  skos:definition "(lat. initialis »am Anfang stehend«) Gemäß der lateinischen Bedeutung versteht man unter Initiale jeden Buchstaben am Textanfang, der gegenüber der Textschrift bzw. – sofern vorhanden – den Satzmajuskeln in Größe oder Form herausgehoben ist. Der Initialenschmuck einer Handschrift ist üblicherweise zu Gliederungszwecken hierarchisch gestaffelt. Initialen wurden in der Regel erst in einem zweiten oder dritten Bearbeitungsschritt der Handschrift in freigelassene Lücken nachgetragen. Einfache farbig (meist rot) abgesetzte Initialen sind insbesondere bei Handschriften ohne Buchschmuck Teil der Rubrizierung. Sekundäre Initialen werden nach ihrer Position im Text unterschieden in Initialmajuskeln, Satzmajuskeln und Versalien."@de;
  dct:bibliographicCitation "Jakobi-Mirwald 2014, 22, 49 +";
  skos:narrower hspv:DECO-H144, hspv:DECO-H150, hspv:DECO-H523, hspv:DECO-H241, hspv:DECO-H819,
    hspv:DECO-H862;
  skos:inScheme hspv:DECO-H;
  skos:topConceptOf hspv:DECO-H .

