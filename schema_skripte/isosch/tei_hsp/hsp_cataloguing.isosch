   <pattern id="note">
      <rule context="tei:msDesc/tei:head/tei:note[@type eq 'headline']">
         <assert test="empty(* except (tei:hi, tei:lb))"
                 diagnostics="d_note_headline_content_en d_note_headline_content_de">A note element of @type 'headline' should not contain any semantic markup elements!</assert>
      </rule>
      <rule context="tei:note[@type eq 'text']">
         <assert test="normalize-space()" diagnostics="d_note_text_en d_note_text_de">If note @type = 'text', then note should not be empty</assert>
      </rule>
      <rule context="tei:note[@type eq 'register']">
         <report test="text()[normalize-space()]"
                 diagnostics="d_note_register_text_en d_note_register_text_de">A note element of @type 'register' must not contain text outside of its p element!</report>
      </rule>
      <rule context="tei:note[@type eq 'register']">
         <assert test="count(tei:p) eq 1"
                 diagnostics="d_note_register_p_cardinality_en d_note_register_p_cardinality_de">A note element of @type 'register' must have exactly one p element!</assert>
      </rule>
      <rule context="tei:note[@type eq 'register']/tei:p">
         <assert test="empty(* except (tei:index))"
                 diagnostics="d_note_register_p_content_en d_note_register_p_content_de">The p element of a note element of @type 'register' must contain only index element(s)!</assert>
      </rule>
      <rule context="tei:note[@type eq 'register']/tei:p">
         <assert test="count(tei:index) ge 1"
                 diagnostics="d_note_register_p_index_cardinality_en d_note_register_p_index_cardinality_de">The p element of a note element of @type 'register' must have one or more index element(s)!</assert>
      </rule>
   </pattern>
   <diagnostics>
      <diagnostic id="d_note_headline_content_en" xml:lang="en">The note section for a headline should not contain semantic markup! -- Please remove semantic markup.</diagnostic>
      <diagnostic id="d_note_headline_content_de" xml:lang="de">Die Anmerkung zur Überschrift darf keine semantischen Auszeichnungen enthalten! -- Bitte entfernen Sie semantische Auszeichnungen.</diagnostic>
      <diagnostic id="d_note_text_en" xml:lang="en">The text note section should not be empty! -- Please add some text.</diagnostic>
      <diagnostic id="d_note_text_de" xml:lang="de">Die Textanmerkung darf nicht leer sein! -- Bitte fügen Sie Text ein.</diagnostic>
      <diagnostic id="d_note_register_text_en" xml:lang="en">The note register section must not contain text outside its paragraph! -- Please move the content into the paragraph.</diagnostic>
      <diagnostic id="d_note_register_text_de" xml:lang="de">Der Anmerkungsbereich für Registereinträge darf keinen Inhalt außerhalb seines Absatzes enthalten! -- Bitte fügen Sie den Inhalt in den Absatz ein.</diagnostic>
      <diagnostic id="d_note_register_p_cardinality_en" xml:lang="en">The note register section must have exactly one paragraph! -- Please enter exactly one paragraph.</diagnostic>
      <diagnostic id="d_note_register_p_cardinality_de" xml:lang="de">Der Anmerkungsbereich für Registereinträge muss genau einen Absatz enthalten! -- Bitte fügen Sie genau einen Absatz ein.</diagnostic>
      <diagnostic id="d_note_register_p_content_en" xml:lang="en">The note register section containts semantic markup which is not allowed! -- Please use allowed semantic markup only.</diagnostic>
      <diagnostic id="d_note_register_p_content_de" xml:lang="de">Der Anmerkungsbereich für Registereinträge enthält unerlaubten Inhalt! -- Bitte verwenden Sie nur die erlaubten semantischen Auszeichnungen.</diagnostic>
      <diagnostic id="d_note_register_p_index_cardinality_en" xml:lang="en">The note section for index entries does not contain an index entry! -- Please add at least one index entry.</diagnostic>
      <diagnostic id="d_note_register_p_index_cardinality_de" xml:lang="de">Der Anmerkungsbereich für Registereinträge enthält keinen Registereintrag! -- Bitte fügen Sie mindestens einen Registereintrag hinzu.</diagnostic>
   </diagnostics>
   <!--Start pattern based on abstract declarable-->
   <pattern id="schematron-constraint-bibl-is-declarable-7">
      <rule context="tei:bibl[ ancestor::tei:teiHeader                                  and                                  following-sibling::tei:bibl                                  and                                  not( preceding-sibling::tei:bibl ) ]">
         <report test="../child::tei:bibl[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:bibl[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <!--Start pattern based on abstract declarable-->
   <pattern id="schematron-constraint-listBibl-is-declarable-8">
      <rule context="tei:listBibl[ ancestor::tei:teiHeader                                  and                                  following-sibling::tei:listBibl                                  and                                  not( preceding-sibling::tei:listBibl ) ]">
         <report test="../child::tei:listBibl[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:listBibl[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-abstractModel-structure-div-in-l-36">
      <rule context="tei:l//tei:div">
         <assert test="ancestor::tei:floatingText"> Abstract model violation: Metrical lines may not contain higher-level structural elements such as div, unless div is a descendant of floatingText.</assert>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-abstractModel-structure-div-in-ab-or-p-37">
      <rule context="tei:div">
         <report test="(ancestor::tei:p or ancestor::tei:ab) and not(ancestor::tei:floatingText)"> Abstract model violation: p and ab may not contain higher-level structural elements such as div, unless div is a descendant of floatingText.</report>
      </rule>
   </pattern>
   <!--Start pattern based on abstract declarable-->
   <pattern id="schematron-constraint-availability-is-declarable-9">
      <rule context="tei:availability[ ancestor::tei:teiHeader                                  and                                  following-sibling::tei:availability                                  and                                  not( preceding-sibling::tei:availability ) ]">
         <report test="../child::tei:availability[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:availability[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <!--Start pattern based on abstract declarable-->
   <pattern id="schematron-constraint-sourceDesc-is-declarable-10">
      <rule context="tei:sourceDesc[ ancestor::tei:teiHeader                                  and                                  following-sibling::tei:sourceDesc                                  and                                  not( preceding-sibling::tei:sourceDesc ) ]">
         <report test="../child::tei:sourceDesc[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:sourceDesc[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <!--Start pattern based on abstract declarable-->
   <pattern id="schematron-constraint-projectDesc-is-declarable-11">
      <rule context="tei:projectDesc[ ancestor::tei:teiHeader                                  and                                  following-sibling::tei:projectDesc                                  and                                  not( preceding-sibling::tei:projectDesc ) ]">
         <report test="../child::tei:projectDesc[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:projectDesc[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <pattern id="msPart_fragment">
      <rule context="tei:msPart[@type eq 'fragment']">
         <assert test="not(following-sibling::tei:msPart[@type eq 'binding'])">Only msPart in the following order are allowed: binding, fragment, booklet, accMat, other</assert>
      </rule>
   </pattern>
   <pattern id="msPart_booklet">
      <rule context="tei:msPart[@type eq 'booklet']">
         <assert test="not( following-sibling::tei:msPart[@type eq 'binding'] or following-sibling::tei:msPart[@type eq 'fragment'])">Only msPart in the following order are allowed: binding, fragment, booklet, accMat, other</assert>
      </rule>
   </pattern>
   <pattern id="msPart_accMat">
      <rule context="tei:msPart[@type eq 'accMat']">
         <assert test="not( following-sibling::tei:msPart[@type eq 'binding'] or following-sibling::tei:msPart[@type eq 'fragment'] or following-sibling::tei:msPart[@type eq 'booklet'])">Only msPart in the following order are allowed: binding, fragment, booklet, accMat, other</assert>
      </rule>
   </pattern>
   <pattern id="msPart_other">
      <rule context="tei:msPart[@type eq 'other']">
         <assert test="not( following-sibling::tei:msPart[@type eq 'binding'] or following-sibling::tei:msPart[@type eq 'fragment'] or following-sibling::tei:msPart[@type eq 'booklet'] or following-sibling::tei:msPart[@type eq 'accMat'])">Only msPart in the following order are allowed: binding, fragment, booklet, accMat, other</assert>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-one_ms_singleton_max-42">
      <rule context="tei:msContents|tei:physDesc|tei:history|tei:additional"> <!-- Note: This rule applies to <msContents>, <physDesc>,
             <history>, and <additional> wherever they occur. Luckily
             they are only allowed in places where they are
             constrained to 0 or 1 occurrence. If that changes someday,
             this constraint may will likely need to be updated,
             too. --> <!-- Also worth noting that
             a) if & when we can use abstract patterns, this would be
             better handled as a single abstract rule somewhere, and
             concrete rules in the individual <elementSpec>s; and
             b) I did not test for the existence of "../*[name(.) eq
             $gi][2]" because then an error would be generated for
             each of the multiple occurrences of $gi. -->
         <let name="gi" value="name(.)"/>
         <report test="preceding-sibling::*[ name(.) eq $gi ]                           and                           not( following-sibling::*[ name(.) eq $gi ] )"> Only one <name/> is allowed as a child of <value-of select="name(..)"/>.</report>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-msId_minimal-43">
      <rule context="tei:msIdentifier">
         <report test="not( parent::tei:msPart )                           and                           ( child::*[1]/self::idno  or  child::*[1]/self::altIdentifier  or  normalize-space(.) eq '')">An msIdentifier must contain either a repository or location.</report>
      </rule>
   </pattern>
   <pattern id="ÄußeresKunst">
      <rule context="tei:physDesc/tei:decoDesc/tei:decoNote">
         <assert test="@type eq 'form' ">It's possible to describe some illuminated aspects of a manuscript here</assert>
      </rule>
   </pattern>
   <pattern id="history">
      <rule context="tei:history">
         <report test="text()[normalize-space()]"
                 diagnostics="d_history_text_en d_history_text_de">A history element must not contain text outside of its p element!</report>
      </rule>
      <rule context="tei:history">
         <assert test="count(tei:p) eq 1"
                 diagnostics="d_history_p_cardinality_en d_history_p_cardinality_de">A history element must have exactly one p element!</assert>
      </rule>
      <rule context="tei:history/tei:p">
         <assert test="empty(* except (tei:lb, tei:hi, tei:index, tei:quote, tei:ref, tei:persName, tei:orgName, tei:placeName))"
                 diagnostics="d_history_p_content_en d_history_p_content_de"> The p element of a history element must contain only lb, hi, index, quote, ref, orgName, placeName, or indexName elements!</assert>
      </rule>
   </pattern>
   <diagnostics>
      <diagnostic id="d_history_text_en" xml:lang="en">The history section must not contain text outside its paragraph! -- Please move the content into the paragraph.</diagnostic>
      <diagnostic id="d_history_text_de" xml:lang="de">Der Abschnitt zur Geschichte darf keinen Inhalt außerhalb seines Absatzes enthalten! -- Bitte fügen Sie den Inhalt in den Absatz ein.</diagnostic>
      <diagnostic id="d_history_p_cardinality_en" xml:lang="en">The history section must have exactly one paragraph! -- Please enter exactly one paragraph.</diagnostic>
      <diagnostic id="d_history_p_cardinality_de" xml:lang="de">Der Abschnitt zur Geschichte muss genau einen Absatz enthalten! -- Bitte fügen Sie genau einen Absatz ein.</diagnostic>
      <diagnostic id="d_history_p_content_en" xml:lang="en">The history section contains semantic markup which is not allowed! -- Please use allowed semantic markup only.</diagnostic>
      <diagnostic id="d_history_p_content_de" xml:lang="de">Der Abschnitt zur Geschichte enthält unerlaubte semantische Auszeichnung! -- Bitte verwenden Sie nur die erlaubten semantischen Auszeichnungen.</diagnostic>
   </diagnostics>
   <pattern id="booklet">
      <rule context="tei:msPart[@type eq 'booklet']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test="(.='booklet') or (.='')">If msPart @type = 'booklet', then form should be 'booklet' or be empty</assert>
      </rule>
   </pattern>
   <pattern id="binding">
      <rule context="tei:msPart[@type eq 'binding']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test="(.='binding') or (.='')">If msPart @type = 'binding', then form should be 'binding' or be empty</assert>
      </rule>
   </pattern>
   <pattern id="accMat">
      <rule context="tei:msPart[@type eq 'accMat']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test=".=('','loose insert')">If msPart @type = 'accMat', then form should be 'loose insert' or be empty</assert>
      </rule>
   </pattern>
   <pattern id="fragment">
      <rule context="tei:msPart[@type eq 'fragment']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test="(.='fragment') or (.='')"
                 diagnostics="d_msPart_fragment_en d_msPart_fragment_de">If msPart @type = 'fragment', then form should be 'fragment' or be empty</assert>
      </rule>
   </pattern>
   <diagnostics>
      <diagnostic id="d_msPart_fragment_en" xml:lang="en">The index entry (added for a manuscript fragment) to describe the form type in the element '<value-of select="name()"/>' (of @type '<value-of select="@type"/>') is given as '<value-of select="."/>', but should be 'fragment' or empty! -- Please use 'fragment' as entry or keep it empty.</diagnostic>
      <diagnostic id="d_msPart_fragment_de" xml:lang="de">Der für ein Handschriftenfragment eingefügte Registereintrag für den Formtyp im Element '<value-of select="name()"/>' (mit @type '<value-of select="@type"/>') lautet '<value-of select="."/>', sollte aber 'fragment' oder leer sein! -- Bitte verwenden Sie den Eintrag 'fragment' oder lassen Sie den Eintrag leer.</diagnostic>
   </diagnostics>
   <pattern id="msPartInmsPartStandard">
      <rule context="tei:msPart[@type eq 'binding' or @type eq 'fragment' or @type eq 'accMat']/tei:msPart">
         <assert test="@type eq 'accMat' or @type eq 'fragment' or @type eq 'other'"> Only bindings, accMat and a fragment may contain further msParts with the following types: accMat, fragment or other</assert>
      </rule>
   </pattern>
   <pattern id="msPartInmsPartBooklet">
      <rule context="tei:msPart[@type eq 'booklet']/tei:msPart">
         <assert test="@type eq 'fragment' or @type eq 'booklet' or @type eq 'accMat' or @type eq 'other'">Only booklets may contain further msParts with the following types: accMat fragment, booklets and other</assert>
      </rule>
   </pattern>
   <pattern id="msPartInmsPartStandardForm">
      <rule context="tei:msPart/tei:msPart[@type eq 'fragment']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test="(.='fragment') or (.='')">If msPart @type = 'fragment', then form should be 'fragment' or be empty</assert>
      </rule>
      <rule context="tei:msPart/tei:msPart[@type eq 'accMat']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test="(.='accMat') or (.='')">If msPart @type = 'accMat', then form should be 'accMat' or be empty</assert>
      </rule>
      <rule context="tei:msPart/tei:msPart[@type eq 'booklet']/tei:head/tei:index/tei:term[@type eq 'form']">
         <assert test="(.='booklet') or (.='')">If msPart @type = 'booklet' then form should be 'booklet' or be empty</assert>
      </rule>
   </pattern>
   <pattern id="idnoKomponenteSonstiges">
      <rule context="tei:msPart[@type eq 'other']/tei:msIdentifier/tei:idno">
         <assert test=".=('Sonstiges')">If msPart @type = 'other' then idno contains 'Sonstiges'</assert>
      </rule>
   </pattern>
   <pattern id="msDesc_altIdentifier_corpus_idno">
      <rule context="tei:msDesc/tei:msIdentifier/tei:altIdentifier[@type eq 'corpus']/tei:idno">
         <assert test="normalize-space()">If altIdentifier @type = 'corpus', then idno should not be empty</assert>
      </rule>
   </pattern>
   <pattern id="msDesc_altIdentifier_former_idno">
      <rule context="tei:msDesc/tei:msIdentifier/tei:altIdentifier[@type eq 'former']/tei:idno">
         <assert test="normalize-space()">If altIdentifier @type = 'former', then idno should not be empty</assert>
      </rule>
   </pattern>
   <pattern id="idnoMsPartAlt">
      <rule context="tei:msPart/tei:msIdentifier/tei:altIdentifier/tei:idno">
         <assert test="normalize-space()">If msPart then idno of altIdentifier should not be empty</assert>
      </rule>
   </pattern>
   <pattern id="childKomponenteSonstiges">
      <rule context="tei:msPart[@type eq 'other']">
         <assert test="tei:p">msPart type="other" may only contain p Elements</assert>
      </rule>
   </pattern>
   <pattern id="msPartoneP">
      <rule context="tei:msPart[@type eq 'booklet' or @type eq 'fragment' or @type eq 'binding' or @type eq 'accMat']">
         <assert test="count(tei:msPart[@type='other']) &lt; 2">only one msPart type='other' is allowed in one msPart</assert>
      </rule>
   </pattern>
   <pattern id="msPartnoP">
      <rule context="tei:msPart[@type eq 'booklet' or @type eq 'fragment' or @type eq 'binding' or @type eq 'accMat']">
         <report test=". != tei:p">booklet, fragment, binding, accMat may not contain a p Element as direct child</report>
      </rule>
   </pattern>
   <!--Start pattern based on abstract declarable-->
