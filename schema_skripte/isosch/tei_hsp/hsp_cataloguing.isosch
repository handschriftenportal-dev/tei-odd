         <report test="../child::tei:listPerson[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:listPerson[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <!--Start pattern based on abstract declarable-->
   <pattern id="schematron-constraint-listPlace-is-declarable-34">
      <rule context="tei:listPlace[ ancestor::tei:teiHeader                                  and                                  following-sibling::tei:listPlace                                  and                                  not( preceding-sibling::tei:listPlace ) ]">
         <report test="../child::tei:listPlace[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:listPlace[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-ref-or-key-or-name-64">
      <rule context="tei:relation">
         <assert test="@ref or @key or @name">One of the attributes @name, @ref or @key must be supplied</assert>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-active-mutual-65">
      <rule context="tei:relation">
         <report test="@active and @mutual">Only one of the attributes @active and @mutual may be supplied</report>
      </rule>
   </pattern>
   <pattern id="schematron-constraint-active-passive-66">
      <rule context="tei:relation">
         <report test="@passive and not(@active)">the attribute @passive may be supplied only if the attribute @active is supplied</report>
      </rule>
   </pattern>
</schema>
