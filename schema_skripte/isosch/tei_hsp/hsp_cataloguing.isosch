         <report test="../child::tei:listOrg[ not( @xml:id ) ]"> When there is more than one <name/>, each must have an @xml:id</report>
         <assert test="count( ../child::tei:listOrg[ normalize-space( @default ) = ('1','true') ] ) eq 1"> When there is more than one <name/>, one and only one must have a @default of 'true'.</assert>
      </rule>
   </pattern>
