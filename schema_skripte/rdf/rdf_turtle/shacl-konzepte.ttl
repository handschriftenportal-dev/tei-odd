<https://data.sparna.fr/shapes-example#> a owl:Ontology, skos:ConceptScheme;
  rdfs:label "HSP Vocabulary SHACL file"@en;
  rdfs:comment "SHACL file for validating HSP domain specific vocabularies"@en;
  dct:description "This SHACL file documents the HSP domain specific vocabularies"@en;
