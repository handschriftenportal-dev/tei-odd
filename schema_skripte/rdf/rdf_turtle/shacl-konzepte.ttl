    dct:bibliographicCitation, skos:example, skos:changeNote, hspv:hasKeyFeature, hspv:hasOneKeyFeatureFrom,
    hspv:hasSomeKeyFeaturesFrom, hspv:hasAdditionalFeature, rdfs:member, schema:contentUrl,
    schema:identifier, schema:caption .

hspv:ConceptShape a sh:NodeShape;
  rdfs:label "Concept"@en;
  rdfs:comment "A thesaurus term or specialist term"@en;
  sh:targetClass skos:Concept;
  sh:nodeKind sh:IRI;
  sh:property skos:notation, skos:inScheme, skos:prefLabel, skos:altLabel, skos:broader,
    skos:narrower, skos:topConceptOf, skos:hiddenLabel, skos:definition, dct:bibliographicCitation,
    skos:example, skos:changeNote, hspv:hasKeyFeature, hspv:hasOneKeyFeatureFrom, hspv:hasSomeKeyFeaturesFrom,
    hspv:hasAdditionalFeature .

hspv:ConceptSchemeShape a sh:NodeShape;
  rdfs:label "ConceptScheme"@en;
  rdfs:comment "A domain or thesaurus"@en;
  sh:targetClass skos:ConceptScheme;
  sh:nodeKind sh:IRI;
  sh:property skos:inScheme, skos:prefLabel, skos:definition, skos:hasTopConcept .

hspv:BagShape a sh:NodeShape;
  rdfs:label "Bag"@en;
