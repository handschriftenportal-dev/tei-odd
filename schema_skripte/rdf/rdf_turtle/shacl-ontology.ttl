<https://data.sparna.fr/shapes-example#> a owl:Ontology, skos:ConceptScheme;
  rdfs:label "HSP Ontology SHACL file"@en;
  rdfs:comment "SHACL file for validating HSP Ontologies"@en;
  dct:description "This SHACL file documents the HSP Ontologies"@en;
  owl:versionInfo "0.1";
  dct:modified "2025-08-08T00:00:00.000Z"^^xsd:dateTime;
  skos:hasTopConcept dc:title, dc:date, dc:description, rdfs:isDefindedBy, rdfs:label,
    rdfs:comment, rdfs:domain, rdfs:range, rdfs:subPropertyOf, rdfs:subClassOf .

hspo:OntologyShape a sh:NodeShape;
  rdfs:label "Ontology"@en;
  rdfs:comment "HSP Ontology"@en;
  sh:targetClass owl:Ontology;
  sh:nodeKind sh:IRI;
  sh:property dc:title, dc:date, dc:description .

hspo:PropertyShape a sh:NodeShape;
  rdfs:label "Property"@en;
  rdfs:comment "Specific properties of the HSP Ontolgy"@en;
  sh:targetClass rdf:Property;
  sh:nodeKind sh:IRI;
  sh:property rdfs:isDefindedBy, rdfs:label, rdfs:comment, rdfs:domain, rdfs:range,
    rdfs:subPropertyOf .

hspo:ClassShape a sh:NodeShape;
  rdfs:label "Class"@en;
  rdfs:comment "Specific classes of the HSP Ontology"@en;
  sh:targetClass rdfs:Class;
  sh:nodeKind sh:IRI;
  sh:property rdfs:isDefindedBy, rdfs:label, rdfs:comment, rdfs:subClassOf .

dc:title a skos:Concept;
  sh:path dc:title;
  sh:name "title"@en;
  sh:description "Title of the ontology"@en;
  sh:nodeKind sh:Literal;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

