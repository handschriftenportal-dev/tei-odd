@prefix schema: <https://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skosthes: <http://purl.org/iso25964/skos-thes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix example: <https://data.sparna.fr/shapes-example/> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix hspv: <https://normdaten.staatsbibliothek-berlin.de/hsp/vocabulary/> .
@prefix hspnorm: <https://normdaten.staatsbibliothek-berlin.de/hsp/authority-file/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xls2rdf: <https://xls2rdf.sparna.fr/vocabulary#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix shacl-play: <https://shacl-play.sparna.fr/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix hspi: <https://normdaten.staatsbibliothek-berlin.de/hsp/initia/> .
@prefix hspo: <https://normdaten.staatsbibliothek-berlin.de/hsp/ontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .

<https://data.sparna.fr/shapes-example#> a owl:Ontology, skos:ConceptScheme;
  rdfs:label "HSP Initia SHACL file"@en;
  rdfs:comment "SHACL file for validating HSP Initia"@en;
  dct:description "This SHACL file documents the HSP Initia"@en;
  owl:versionInfo "0.1";
  dct:modified "2025-08-08T00:00:00.000Z"^^xsd:dateTime;
  skos:hasTopConcept schema:text, hspo:alternativeText, dct:language, dct:relation,
    hspo:sameAs, hspo:closeRelation, hspo:distantRelation .

hspi:InitiumShape a sh:NodeShape;
  rdfs:label "Initium"@en;
  rdfs:comment "The beginning of a handwritten text, partially normalized"@en;
  sh:targetClass hspo:Initium;
  sh:nodeKind sh:IRI;
  sh:property schema:text, hspo:alternativeText, dct:language, dct:relation, hspo:sameAs,
    hspo:closeRelation, hspo:distantRelation .

schema:text a skos:Concept;
  sh:path schema:text;
  sh:name "text"@en;
  sh:description "The textual content of the initium"@en;
  sh:minCount "1"^^xsd:integer;
  sh:maxCount "1"^^xsd:integer;
  sh:nodeKind sh:Literal;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

hspo:alternativeText a skos:Concept;
  sh:path hspo:alternativeText;
  sh:name "alternativeText"@en;
  sh:description "Alternative textual forms of the initium"@en;
  sh:nodeKind sh:Literal;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

dct:language a skos:Concept;
  sh:path dct:language;
  sh:name "language"@en;
  sh:description "The language of the initium"@en;
  sh:minCount "1"^^xsd:integer;
  sh:nodeKind sh:IRIOrLiteral;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

dct:relation a skos:Concept;
  sh:path dct:relation;
  sh:name "relation"@en;
  sh:description "A relation between two initia"@en;
  sh:nodeKind sh:IRI;
  sh:class hspo:Initium;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

hspo:sameAs a skos:Concept;
  sh:path hspo:sameAs;
  sh:name "sameAs"@en;
  sh:description "A relation between two initia of the same content"@en;
  sh:nodeKind sh:IRI;
  sh:class hspo:Initium;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

hspo:closeRelation a skos:Concept;
  sh:path hspo:closeRelation;
  sh:name "closeRelation"@en;
  sh:description "A close relation between two initia"@en;
  sh:nodeKind sh:IRI;
  sh:class hspo:Initium;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .

hspo:distantRelation a skos:Concept;
  sh:path hspo:distantRelation;
  sh:name "distantRelation"@en;
  sh:description "A distant relation between two initia"@en;
  sh:nodeKind sh:IRI;
  sh:class hspo:Initium;
  skos:inScheme <https://data.sparna.fr/shapes-example#>;
  skos:topConceptOf <https://data.sparna.fr/shapes-example#> .
